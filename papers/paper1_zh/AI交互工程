    ARTIFACT = "artifact"     # 产物

@dataclass(frozen=True, slots=True)
class LifeID:
    """
    生命标识符 - 全局唯一，包含时空信息
    格式: kind:uuid:timestamp:entropy
    """
    kind: EntityKind
    uuid: uuid.UUID = field(default_factory=uuid.uuid4)
    born_at: datetime = field(default_factory=datetime.utcnow)
    entropy: int = field(default_factory=lambda: uuid.uuid4().int % 10000)
    
    def __str__(self) -> str:
        ts = int(self.born_at.timestamp() * 1000)
        return f"{self.kind.value}:{self.uuid.hex}:{ts}:{self.entropy}"
    
    @property
    def short(self) -> str:
        return f"{self.kind.value}:{self.uuid.hex[:8]}"
    
    @classmethod
    def parse(cls, raw: str) -> LifeID:
        parts = raw.split(":")
        return cls(
            kind=EntityKind(parts[0]),
            uuid=uuid.UUID(parts[1]),
            born_at=datetime.fromtimestamp(int(parts[2]) / 1000),
            entropy=int(parts[3])
        )

