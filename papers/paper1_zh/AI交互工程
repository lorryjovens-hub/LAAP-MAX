## 二、长程任务规划引擎（LongHaul Engine）

```python
# src/hermes/longhaul/engine.py
"""
LongHaul Engine — 长程任务规划引擎
支持从分钟到季度的任务规划，具备完整的持久化、恢复、进度跟踪能力。
"""

import asyncio
import json
import logging
import uuid
from dataclasses import asdict, dataclass, field
from datetime import datetime, timedelta
from enum import Enum, auto
from typing import Any, Callable, Dict, List, Optional, Set, Tuple

import networkx as nx
from networkx.algorithms.dag import topological_sort

logger = logging.getLogger("hermes.longhaul")


class TaskStatus(Enum):
    PENDING = auto()
    BLOCKED = auto()       # 依赖未完成
    READY = auto()       # 依赖完成，等待执行
    RUNNING = auto()
    PAUSED = auto()
    COMPLETED = auto()
    FAILED = auto()
    RETRYING = auto()
    CANCELLED = auto()


class TaskPriority(Enum):
    CRITICAL = 1      # 阻塞整个项目
    HIGH = 2
    NORMAL = 3
    LOW = 4
    BACKLOG = 5


@dataclass
class TaskDefinition:
    """任务定义"""
    task_id: str = field(default_factory=lambda: str(uuid.uuid4())[:8])
    name: str = ""
    description: str = ""
    
    # 执行信息
    executor_type: str = "agent"  # "agent", "human", "tool", "composite"
    executor_config: Dict[str, Any] = field(default_factory=dict)
    
    # 时间规划
    estimated_duration: timedelta = field(default_factory=lambda: timedelta(hours=1))
    earliest_start: Optional[datetime] = None
    deadline: Optional[datetime] = None
    
    # 依赖
    dependencies: List[str] = field(default_factory=list)  # task_id 列表
    soft_dependencies: List[str] = field(default_factory=list)  # 可并行但建议顺序
    
    # 资源需求
    required_capabilities: Set[str] = field(default_factory=set)
    required_tools: List[str] = field(default_factory=list)
    
    # 优先级与风险
    priority: TaskPriority = TaskPriority.NORMAL
    risk_level: str = "low"  # low, medium, high
    
    # 输出产物
    expected_artifacts: List[str] = field(default_factory=list)
    acceptance_criteria: List[str] = field(default_factory=list)
    
    # 重试策略
    max_retries: int = 3
    retry_delay: timedelta = field(default_factory=lambda: timedelta(minutes=5))
    
    # 元数据
    domain: str = ""  # "frontend", "backend", "database", "devops", "design"
    tags: Set[str] = field(default_factory=set)


@dataclass
class TaskState:
    """任务运行时状态"""
    task_id: str = ""
    status: TaskStatus = TaskStatus.PENDING
    progress_percent: float = 0.0  # 0-100
    
    # 执行记录
    assigned_executor: Optional[str] = None
    started_at: Optional[datetime] = None
    completed_at: Optional[datetime] = None
    last_updated: datetime = field(default_factory=datetime.utcnow)
    
    # 重试计数
    attempt_count: int = 0
    
    # 产物
    produced_artifacts: Dict[str, Any] = field(default_factory=dict)
    execution_logs: List[str] = field(default_factory=list)
    
    # 阻塞原因
    blocked_reason: Optional[str] = None
    failure_reason: Optional[str] = None


@dataclass
class Milestone:
    """里程碑"""
    milestone_id: str = field(default_factory=lambda: str(uuid.uuid4())[:8])
    name: str = ""
    description: str = ""
    target_date: Optional[datetime] = None
    required_tasks: List[str] = field(default_factory=list)
    status: str = "pending"  # pending, reached, missed
    
    # 验收标准
    deliverables: List[str] = field(default_factory=list)


@dataclass
class ProjectPlan:
    """项目计划"""
    plan_id: str = field(default_factory=lambda: str(uuid.uuid4())[:8])
    name: str = ""
    description: str = ""
    created_at: datetime = field(default_factory=datetime.utcnow)
    
    # 任务图谱
    tasks: Dict[str, TaskDefinition] = field(default_factory=dict)
    task_states: Dict[str, TaskState] = field(default_factory=dict)
    dag: nx.DiGraph = field(default_factory=nx.DiGraph)
    
    # 里程碑
    milestones: List[Milestone] = field(default_factory=list)
    
    # 全局配置
    global_deadline: Optional[datetime] = None
    working_hours_per_day: float = 8.0
    working_days_per_week: int = 5
    
    # 当前状态
    current_phase: str = "init"
    overall_progress: float = 0.0
    
    # 事件溯源
    event_log: List[Dict] = field(default_factory=list)


class TaskDAGBuilder:
    """
    任务 DAG 构建器
    将高层需求分解为可执行的任务图谱
    """
    
    def __init__(self):
        self._tasks: Dict[str, TaskDefinition] = {}
        self._dag = nx.DiGraph()
    
    def add_task(self, task: TaskDefinition) -> "TaskDAGBuilder":
        """添加任务"""
        self._tasks[task.task_id] = task
        self._dag.add_node(task.task_id, data=task)
        return self
    
    def add_dependency(self, from_task: str, to_task: str) -> "TaskDAGBuilder":
        """添加依赖：to_task 依赖 from_task（from_task 先执行）"""
        if from_task not in self._tasks or to_task not in self._tasks:
            raise ValueError("Both tasks must be added before linking")
        self._dag.add_edge(from_task, to_task)
        self._tasks[to_task].dependencies.append(from_task)
        return self
    
    def add_milestone(self, name: str, task_ids: List[str]) -> Milestone:
        """添加里程碑"""
        ms = Milestone(name=name, required_tasks=task_ids)
        return ms
    
    def validate(self) -> bool:
        """验证 DAG 无环"""
        try:
            list(topological_sort(self._dag))
            return True
        except nx.NetworkXUnfeasible:
            return False
    
    def build(self) -> Tuple[Dict[str, TaskDefinition], nx.DiGraph]:
        """构建"""
        if not self.validate():
            raise ValueError("Task DAG contains cycles")
        return self._tasks, self._dag
    
    def estimate_critical_path(self) -> List[str]:
        """估算关键路径"""
        # 简化：最长路径
        try:
            return nx.dag_longest_path(self._dag)
        except Exception:
            return []


class CheckpointManager:
    """
    检查点管理器
    支持任务级、项目级检查点，确保数月任务可恢复
    """
    
    def __init__(self, storage_path: str = ".hermes/checkpoints"):
        self.storage_path = storage_path
        self._checkpoints: Dict[str, List[Dict]] = {}  # plan_id -> checkpoints
    
    async def save_checkpoint(self, plan: ProjectPlan, label: str = "") -> str:
        """保存检查点"""
        checkpoint = {
            "checkpoint_id": f"chk_{uuid.uuid4().hex[:8]}",
            "plan_id": plan.plan_id,
            "timestamp": datetime.utcnow().isoformat(),
            "label": label,
            "state": {
                "task_states": {
                    tid: asdict(ts) for tid, ts in plan.task_states.items()
                },
                "milestones": [asdict(m) for m in plan.milestones],
                "current_phase": plan.current_phase,
                "overall_progress": plan.overall_progress,
                "event_log_tail": plan.event_log[-100:] if plan.event_log else []
            }
        }
        
        if plan.plan_id not in self._checkpoints:
            self._checkpoints[plan.plan_id] = []
        self._checkpoints[plan.plan_id].append(checkpoint)
        
        # 持久化到磁盘
        import os
        os.makedirs(self.storage_path, exist_ok=True)
        filename = f"{self.storage_path}/{plan.plan_id}_{checkpoint['checkpoint_id']}.json"
        with open(filename, 'w') as f:
            json.dump(checkpoint, f, indent=2, default=str)
        
        logger.info(f"Checkpoint saved: {checkpoint['checkpoint_id']} for plan {plan.plan_id}")
        return checkpoint["checkpoint_id"]
    
    async def load_checkpoint(self, plan_id: str, checkpoint_id: Optional[str] = None) -> Optional[Dict]:
        """加载检查点"""
        # 尝试内存
        if plan_id in self._checkpoints:
            if checkpoint_id:
                for chk in self._checkpoints[plan_id]:
                    if chk["checkpoint_id"] == checkpoint_id:
                        return chk
            else:
                # 返回最新
                return self._checkpoints[plan_id][-1]
        
        # 尝试磁盘
        import os
        import glob
        pattern = f"{self.storage_path}/{plan_id}_*.json"
        files = glob.glob(pattern)
        if not files:
            return None
        
        # 按时间排序
        files.sort(key=os.path.getmtime, reverse=True)
        with open(files[0], 'r') as f:
            return json.load(f)
    
    async def list_checkpoints(self, plan_id: str) -> List[Dict]:
        """列出检查点"""
        return self._checkpoints.get(plan_id, [])


class ProgressTracker:
    """
    进度跟踪器
    实时计算项目进度，预测完成时间
    """
    
    def __init__(self, plan: ProjectPlan):
        self.plan = plan
    
    def calculate_progress(self) -> Dict[str, Any]:
        """计算进度"""
        total = len(self.plan.tasks)
        if total == 0:
            return {"overall": 0.0, "by_domain": {}, "by_phase": {}}
        
        completed = sum(1 for ts in self.plan.task_states.values() if ts.status == TaskStatus.COMPLETED)
        failed = sum(1 for ts in self.plan.task_states.values() if ts.status == TaskStatus.FAILED)
        running = sum(1 for ts in self.plan.task_states.values() if ts.status == TaskStatus.RUNNING)
        
        # 加权进度（考虑任务预估时长）
        total_weighted = 0.0
        completed_weighted = 0.0
        
        for tid, task in self.plan.tasks.items():
            weight = task.estimated_duration.total_seconds()
            total_weighted += weight
            
            if tid in self.plan.task_states:
                ts = self.plan.task_states[tid]
                if ts.status == TaskStatus.COMPLETED:
                    completed_weighted += weight
                elif ts.status == TaskStatus.RUNNING:
                    completed_weighted += weight * (ts.progress_percent / 100)
        
        overall = (completed_weighted / total_weighted * 100) if total_weighted > 0 else 0
        
        # 按领域分组
        by_domain = {}
        for tid, task in self.plan.tasks.items():
            domain = task.domain or "uncategorized"
            if domain not in by_domain:
                by_domain[domain] = {"total": 0, "completed": 0, "weighted": 0.0, "total_weight": 0.0}
            
            by_domain[domain]["total"] += 1
            weight = task.estimated_duration.total_seconds()
            by_domain[domain]["total_weight"] += weight
            
            if tid in self.plan.task_states:
                ts = self.plan.task_states[tid]
                if ts.status == TaskStatus.COMPLETED:
                    by_domain[domain]["completed"] += 1
                    by_domain[domain]["weighted"] += weight
        
        # 计算百分比
        for domain in by_domain:
            tw = by_domain[domain]["total_weight"]
            by_domain[domain]["progress"] = (by_domain[domain]["weighted"] / tw * 100) if tw > 0 else 0
        
        # 预测完成时间
        etc = self._estimate_completion()
        
        return {
            "overall": round(overall, 2),
            "completed_tasks": completed,
            "failed_tasks": failed,
            "running_tasks": running,
            "total_tasks": total,
            "by_domain": {k: round(v["progress"], 2) for k, v in by_domain.items()},
            "estimated_completion": etc.isoformat() if etc else None,
            "critical_path": TaskDAGBuilder().estimate_critical_path()  # 需要重新构建
        }
    
    def _estimate_completion(self) -> Optional[datetime]:
        """预测完成时间"""
        # 基于已完成任务的平均速度
        completed_tasks = [
            ts for ts in self.plan.task_states.values()
            if ts.status == TaskStatus.COMPLETED and ts.started_at and ts.completed_at
        ]
        
        if not completed_tasks:
            return None
        
        avg_duration = sum(
            (ts.completed_at - ts.started_at).total_seconds()
            for ts in completed_tasks
        ) / len(completed_tasks)
        
        remaining = sum(
            1 for ts in self.plan.task_states.values()
            if ts.status not in (TaskStatus.COMPLETED, TaskStatus.CANCELLED)
        )
        
        seconds_remaining = remaining * avg_duration
        return datetime.utcnow() + timedelta(seconds=seconds_remaining)
    
    def generate_report(self) -> str:
        """生成进度报告"""
        progress = self.calculate_progress()
        
        lines = [
            f"=== PROJECT REPORT: {self.plan.name} ===",
            f"Overall Progress: {progress['overall']}%",
            f"Tasks: {progress['completed_tasks']}/{progress['total_tasks']} completed",
            f"Running: {progress['running_tasks']}",
            f"Failed: {progress['failed_tasks']}",
            "",
            "By Domain:"
        ]
        
        for domain, prog in progress['by_domain'].items():
            lines.append(f"  {domain}: {prog}%")
        
        if progress['estimated_completion']:
            lines.append(f"\nEstimated Completion: {progress['estimated_completion']}")
        
        return "\n".join(lines)


class LongHaulEngine:
    """
    长程引擎 — 核心编排器
    """
    
    def __init__(self):
        self._plans: Dict[str, ProjectPlan] = {}
        self._checkpoint_mgr = CheckpointManager()
        self._running: Dict[str, asyncio.Task] = {}  # plan_id -> task
        self._shutdown = asyncio.Event()
    
    async def create_plan(
        self,
        name: str,
        description: str,
        deadline: Optional[datetime] = None
    ) -> ProjectPlan:
        """创建项目计划"""
        plan = ProjectPlan(
            name=name,
            description=description,
            global_deadline=deadline
        )
        self._plans[plan.plan_id] = plan
        logger.info(f"Plan created: {plan.plan_id} - {name}")
        return plan
    
    async def populate_plan(
        self,
        plan_id: str,
        tasks: List[TaskDefinition],
        dependencies: List[Tuple[str, str]]
    ):
        """填充任务"""
        plan = self._plans.get(plan_id)
        if not plan:
            raise ValueError(f"Plan not found: {plan_id}")
        
        # 添加任务
        for task in tasks:
            plan.tasks[task.task_id] = task
            plan.dag.add_node(task.task_id, data=task)
            plan.task_states[task.task_id] = TaskState(task_id=task.task_id)
        
        # 添加依赖
        for from_id, to_id in dependencies:
            plan.dag.add_edge(from_id, to_id)
            if to_id in plan.tasks:
                plan.tasks[to_id].dependencies.append(from_id)
        
        # 验证
        if not nx.is_directed_acyclic_graph(plan.dag):
            raise ValueError("Task dependencies contain cycles")
        
        # 初始化状态
        await self._update_task_readiness(plan)
    
    async def _update_task_readiness(self, plan: ProjectPlan):
        """更新任务就绪状态"""
        for tid, task in plan.tasks.items():
            state = plan.task_states[tid]
            if state.status == TaskStatus.PENDING:
                # 检查依赖是否完成
                deps_satisfied = all(
                    plan.task_states[dep].status == TaskStatus.COMPLETED
                    for dep in task.dependencies
                    if dep in plan.task_states
                )
                
                if deps_satisfied:
                    state.status = TaskStatus.READY
                else:
                    state.status = TaskStatus.BLOCKED
                    missing = [
                        dep for dep in task.dependencies
                        if dep in plan.task_states and plan.task_states[dep].status != TaskStatus.COMPLETED
                    ]
                    state.blocked_reason = f"Waiting for: {missing}"
    
    async def execute_plan(
        self,
        plan_id: str,
        executor_factory: Callable[[TaskDefinition], Callable]
    ):
        """
        执行计划
        
        executor_factory: 根据任务定义返回执行函数的工厂
        """
        plan = self._plans[plan_id]
        tracker = ProgressTracker(plan)
        
        logger.info(f"Starting execution of plan: {plan.name}")
        
        while not self._shutdown.is_set():
            # 1. 更新就绪状态
            await self._update_task_readiness(plan)
            
            # 2. 获取可执行的任务（READY 状态）
            ready_tasks = [
                tid for tid, ts in plan.task_states.items()
                if ts.status == TaskStatus.READY
            ]
            
            if not ready_tasks:
                # 检查是否全部完成
                all_done = all(
                    ts.status in (TaskStatus.COMPLETED, TaskStatus.CANCELLED, TaskStatus.FAILED)
                    for ts in plan.task_states.values()
                )
                if all_done:
                    logger.info(f"Plan {plan_id} completed")
                    break
                
                # 等待一段时间再检查
                await asyncio.sleep(10)
                continue
            
            # 3. 按优先级排序
            ready_tasks.sort(key=lambda tid: plan.tasks[tid].priority.value)
            
            # 4. 并行执行（限制并发）
            for tid in ready_tasks[:3]:  # 最多并行3个
                task = plan.tasks[tid]
                state = plan.task_states[tid]
                
                state.status = TaskStatus.RUNNING
                state.started_at = datetime.utcnow()
                state.attempt_count += 1
                
                # 异步执行
                asyncio.create_task(self._execute_single_task(plan, task, state, executor_factory))
            
            # 5. 定期保存检查点
            if sum(1 for ts in plan.task_states.values() if ts.status == TaskStatus.COMPLETED) % 5 == 0:
                await self._checkpoint_mgr.save_checkpoint(plan, label="auto")
            
            # 6. 报告进度
            report = tracker.generate_report()
            logger.info(f"\n{report}")
            
            await asyncio.sleep(5)
    
    async def _execute_single_task(
        self,
        plan: ProjectPlan,
        task: TaskDefinition,
        state: TaskState,
        executor_factory: Callable
    ):
        """执行单个任务"""
        try:
            executor = executor_factory(task)
            result = await executor(task)
            
            # 成功
            state.status = TaskStatus.COMPLETED
            state.completed_at = datetime.utcnow()
            state.progress_percent = 100.0
            state.produced_artifacts = result.get("artifacts", {})
            state.execution_logs.append(f"Completed at {datetime.utcnow()}")
            
            plan.event_log.append({
                "type": "task_completed",
                "task_id": task.task_id,
                "timestamp": datetime.utcnow().isoformat()
            })
            
        except Exception as e:
            logger.error(f"Task {task.task_id} failed: {e}")
            state.execution_logs.append(f"Failed: {str(e)}")
            
            if state.attempt_count < task.max_retries:
                state.status = TaskStatus.RETRYING
                await asyncio.sleep(task.retry_delay.total_seconds())
            else:
                state.status = TaskStatus.FAILED
                state.failure_reason = str(e)
        
        state.last_updated = datetime.utcnow()
    
    async def pause_plan(self, plan_id: str):
        """暂停计划"""
        # 标记所有 RUNNING 为 PAUSED
        plan = self._plans[plan_id]
        for ts in plan.task_states.values():
            if ts.status == TaskStatus.RUNNING:
                ts.status = TaskStatus.PAUSED
        await self._checkpoint_mgr.save_checkpoint(plan, label="pause")
        logger.info(f"Plan {plan_id} paused")
    
    async def resume_plan(self, plan_id: str, checkpoint_id: Optional[str] = None):
        """从检查点恢复"""
        checkpoint = await self._checkpoint_mgr.load_checkpoint(plan_id, checkpoint_id)
        if not checkpoint:
            raise ValueError(f"No checkpoint found for plan {plan_id}")
        
        # 恢复状态
        plan = self._plans[plan_id]
        state_data = checkpoint["state"]["task_states"]
        for tid, data in state_data.items():
            if tid in plan.task_states:
                ts = plan.task_states[tid]
                ts.status = TaskStatus[data.get("status", "PENDING").split(".")[-1]]
                ts.progress_percent = data.get("progress_percent", 0)
                ts.produced_artifacts = data.get("produced_artifacts", {})
        
        plan.current_phase = checkpoint["state"].get("current_phase", "init")
        plan.overall_progress = checkpoint["state"].get("overall_progress", 0)
        
        logger.info(f"Plan {plan_id} resumed from checkpoint {checkpoint['checkpoint_id']}")
        return plan
    
    async def get_plan_status(self, plan_id: str) -> Dict[str, Any]:
        """获取计划状态"""
        plan = self._plans.get(plan_id)
        if not plan:
            return {"error": "Plan not found"}
        
        tracker = ProgressTracker(plan)
        return {
            "plan": {
                "id": plan.plan_id,
                "name": plan.name,
                "phase": plan.current_phase
            },
            "progress": tracker.calculate_progress(),
            "tasks": {
                tid: {
                    "status": ts.status.name,
                    "progress": ts.progress_percent,
                    "attempts": ts.attempt_count
                }
                for tid, ts in plan.task_states.items()
            }
        }
