class ToolRegistry:
    """
    工具注册表 - 工具的发现、注册、版本管理
    生命体隐喻：基因库
    """
    
    def __init__(self):
        self._tools: Dict[str, ToolDriver] = {}
        self._schemas: Dict[str, ToolSchema] = {}
        self._versions: Dict[str, List[str]] = defaultdict(list)
        self._capability_index: Dict[str, Set[str]] = defaultdict(set)
        self._lock = asyncio.RLock()
        self._health_cache: Dict[str, VitalSigns] = {}
    
    async def register(self, tool: ToolDriver) -> bool:
        """注册工具"""
        schema = tool.schema
        async with self._lock:
            if schema.name in self._tools:
                logger.warning(f"Tool {schema.name} already registered, updating")
            
            self._tools[schema.name] = tool
            self._schemas[schema.name] = schema
            self._versions[schema.name].append(
                getattr(tool, 'version', '1.0.0')
            )
            
            # 更新能力索引
            for cap in schema.required_capabilities:
                self._capability_index[cap].add(schema.name)
            
            TOOL_REGISTRY_SIZE.set(len(self._tools))
            logger.info(f"Tool registered: {schema.name}")
            return True
    
    async def unregister(self, tool_name: str) -> bool:
        """注销工具"""
        async with self._lock:
            if tool_name not in self._tools:
                return False
            
            tool = self._tools.pop(tool_name)
            schema = self._schemas.pop(tool_name)
            
            for cap in schema.required_capabilities:
                self._capability_index[cap].discard(tool_name)
            
            TOOL_REGISTRY_SIZE.set(len(self._tools))
            logger.info(f"Tool unregistered: {tool_name}")
            return True
    
    def get(self, tool_name: str) -> Optional[ToolDriver]:
        """获取工具"""
        return self._tools.get(tool_name)
    
    def get_schema(self, tool_name: str) -> Optional[ToolSchema]:
        """获取 schema"""
        return self._schemas.get(tool_name)
    
    def find_by_capability(self, capability: str) -> List[str]:
        """按能力查找工具"""
        return list(self._capability_index.get(capability, set()))
    
    def list_all(self) -> List[ToolSchema]:
        """列出所有工具 schema"""
        return list(self._schemas.values())
    
    async def health_check_all(self) -> Dict[str, VitalSigns]:
        """批量健康检查"""
        results = {}
        for name, tool in self._tools.items():
            try:
                vitals = await asyncio.wait_for(
                    tool.health_check(),
                    timeout=5.0
                )
                results[name] = vitals
                self._health_cache[name] = vitals
            except Exception as e:
                logger.error(f"Health check failed for {name}: {e}")
                results[name] = VitalSigns(health_score=0.0)
        return results


class SchemaValidator:
    """
    Schema 验证器 - 参数校验、类型检查、安全过滤
    生命体隐喻：免疫系统
    """
    
    def __init__(self):
        self._dangerous_patterns = [
            "__import__", "eval(", "exec(", "os.system",
            "subprocess", "open(", "file://", "http://"
        ]
    
    def validate(self, call: ToolCall, schema: ToolSchema) -> Optional[str]:
        """
        验证工具调用
        返回 None 表示验证通过，否则返回错误信息
        """
        # 1. 参数 schema 验证
        try:
            jsonschema.validate(
                instance=call.arguments,
                schema=schema.parameters
            )
        except jsonschema.ValidationError as e:
            return f"Schema validation failed: {e.message}"
        
        # 2. 安全模式检测（字符串参数）
        def check_security(obj: Any, path: str = "") -> Optional[str]:
            if isinstance(obj, str):
                lower = obj.lower()
                for pattern in self._dangerous_patterns:
                    if pattern in lower:
                        return f"Security violation at {path}: forbidden pattern '{pattern}'"
            elif isinstance(obj, dict):
                for k, v in obj.items():
                    result = check_security(v, f"{path}.{k}")
                    if result:
                        return result
            elif isinstance(obj, list):
                for i, v in enumerate(obj):
                    result = check_security(v, f"{path}[{i}]")
                    if result:
                        return result
            return None
        
        security_issue = check_security(call.arguments)
        if security_issue:
            return security_issue
        
        # 3. 参数大小限制
        args_size = len(json.dumps(call.arguments))
        if args_size > 1024 * 1024:  # 1MB
            return "Arguments too large (>1MB)"
        
        return None


class SandboxDispatcher:
    """
    沙箱调度器 - 根据工具副作用决定执行环境
    生命体隐喻：细胞膜 - 控制物质进出
    """
    
    def __init__(self):
        self._sandbox_pool: Dict[str, Any] = {}  # 沙箱实例池
        self._local_executor = ThreadPoolExecutor(max_workers=20)
    
    async def dispatch(
        self,
        tool: ToolDriver,
        call: ToolCall,
        ctx: ExecutionContext
    ) -> Any:
        """
        调度执行
        
        策略：
        - 无副作用 + 幂等 → 本地协程
        - 有网络副作用 → 网络隔离沙箱
        - 有文件/执行副作用 → 完全隔离沙箱 (gVisor)
        """
        schema = tool.schema
        side_effects = set(schema.side_effects)
        
        if not side_effects or side_effects == {"read"}:
            # 纯函数式工具 - 本地执行
            return await self._execute_local(tool, call, ctx)
        
        elif "network" in side_effects and "exec" not in side_effects:
            # 网络工具 - 网络命名空间隔离
            return await self._execute_network_sandbox(tool, call, ctx)
        
        else:
            # 高危工具 - 完全沙箱
            return await self._execute_full_sandbox(tool, call, ctx)
    
    async def _execute_local(
        self,
        tool: ToolDriver,
        call: ToolCall,
        ctx: ExecutionContext
    ) -> ToolResult:
        """本地执行"""
        loop = asyncio.get_event_loop()
        return await tool.execute(call, ctx)
    
    async def _execute_network_sandbox(
        self,
        tool: ToolDriver,
        call: ToolCall,
        ctx: ExecutionContext
    ) -> ToolResult:
        """网络隔离执行"""
        # 实现：使用 unshare/网络命名空间
        # 简化：委托给本地但添加网络监控
        return await self._execute_local(tool, call, ctx)
    
    async def _execute_full_sandbox(
        self,
        tool: ToolDriver,
        call: ToolCall,
        ctx: ExecutionContext
    ) -> ToolResult:
        """完全沙箱执行 - 使用子进程/Docker"""
        # 生产实现：使用 gVisor/runsc 或 Firecracker
        # 简化版本：使用 asyncio subprocess
        return await self._execute_local(tool, call, ctx)


class CircuitBreaker:
    """
    熔断器 - 防止级联故障
    生命体隐喻：痛觉反射 - 保护机体
    """
    
    def __init__(
        self,
        failure_threshold: int = 5,
        recovery_timeout: float = 30.0,
        half_open_max_calls: int = 3
    ):
        self.failure_threshold = failure_threshold
        self.recovery_timeout = recovery_timeout
        self.half_open_max_calls = half_open_max_calls
        
        self._states: Dict[str, str] = defaultdict(lambda: "closed")
        self._failure_counts: Dict[str, int] = defaultdict(int)
        self._last_failure_time: Dict[str, float] = {}
        self._half_open_calls: Dict[str, int] = defaultdict(int)
        self._lock = asyncio.Lock()
    
    async def call(
        self,
        tool_name: str,
        operation: Callable[..., Any],
        *args,
        **kwargs
    ) -> Any:
        """带熔断保护的调用"""
        async with self._lock:
            state = self._states[tool_name]
            
            if state == "open":
                last_fail = self._last_failure_time.get(tool_name, 0)
                if time.time() - last_fail > self.recovery_timeout:
                    self._states[tool_name] = "half_open"
                    self._half_open_calls[tool_name] = 0
                    logger.info(f"Circuit breaker half-open for {tool_name}")
                else:
                    raise CircuitBreakerOpen(f"Circuit breaker open for {tool_name}")
            
            elif state == "half_open":
                if self._half_open_calls[tool_name] >= self.half_open_max_calls:
                    raise CircuitBreakerOpen(f"Circuit breaker half-open limit for {tool_name}")
                self._half_open_calls[tool_name] += 1
        
        try:
            result = await operation(*args, **kwargs)
            await self._on_success(tool_name)
            return result
        except Exception as e:
            await self._on_failure(tool_name)
            raise
    
    async def _on_success(self, tool_name: str):
        async with self._lock:
            if self._states[tool_name] == "half_open":
                self._states[tool_name] = "closed"
                self._failure_counts[tool_name] = 0
                self._half_open_calls[tool_name] = 0
                logger.info(f"Circuit breaker closed for {tool_name}")
    
    async def _on_failure(self, tool_name: str):
        async with self._lock:
            self._failure_counts[tool_name] += 1
            self._last_failure_time[tool_name] = time.time()
            
            if self._states[tool_name] == "half_open":
                self._states[tool_name] = "open"
                logger.warning(f"Circuit breaker opened for {tool_name}")
            elif self._failure_counts[tool_name] >= self.failure_threshold:
                self._states[tool_name] = "open"
                logger.warning(f"Circuit breaker opened for {tool_name}")


class CircuitBreakerOpen(Exception):
    pass


class HermesHarness:
    """
    Hermes Harness - 工具调用引擎主类
    生命体隐喻：神经系统中枢
    """
    
    def __init__(
        self,
        registry: Optional[ToolRegistry] = None,
        validator: Optional[SchemaValidator] = None,
        dispatcher: Optional[SandboxDispatcher] = None,
        max_concurrent_calls: int = 100
    ):
        self.registry = registry or ToolRegistry()
        self.validator = validator or SchemaValidator()
        self.dispatcher = dispatcher or SandboxDispatcher()
        self.circuit_breaker = CircuitBreaker()
        
        # 并发控制
        self._semaphore = asyncio.Semaphore(max_concurrent_calls)
        self._call_count = 0
        
        # 事件流
        self._event_queue: asyncio.Queue[LifeEvent] = asyncio.Queue()
        self._event_subscribers: List[Callable[[LifeEvent], Any]] = []
        
        # 缓存
        self._result_cache: Dict[str, ToolResult] = {}
        self._cache_ttl: Dict[str, float] = {}
        
        # 生命周期
        self._state = LifeState.GESTATION
        self._shutdown_event = asyncio.Event()
    
    async def initialize(self):
        """初始化"""
        self._state = LifeState.ALIVE
        # 启动事件泵
        asyncio.create_task(self._event_pump())
        logger.info("HermesHarness initialized")
    
    async def call(
        self,
        tool_call: ToolCall,
        ctx: Optional[ExecutionContext] = None
    ) -> ToolResult:
        """
        执行工具调用 - 主入口
        
        流程：
        1. 查找工具
        2. 验证参数
        3. 检查缓存（幂等工具）
        4. 熔断检查
        5. 并发控制
        6. 沙箱调度
        7. 超时控制
        8. 重试
        9. 结果缓存
        10. 事件发射
        """
        ctx = ctx or ExecutionContext(trace_id=tool_call.trace_id)
        tool_name = tool_call.tool_name
        
        # 1. 查找工具
        tool = self.registry.get(tool_name)
        if not tool:
            return ToolResult(
                call_id=tool_call.call_id,
                tool_name=tool_name,
                status="error",
                error_message=f"Tool not found: {tool_name}"
            )
        
        schema = self.registry.get_schema(tool_name)
        
        # 2. 验证
        validation_error = self.validator.validate(tool_call, schema)
        if validation_error:
            TOOL_CALLS_TOTAL.labels(tool_name=tool_name, status="rejected").inc()
            return ToolResult(
                call_id=tool_call.call_id,
                tool_name=tool_name,
                status="rejected",
                error_message=validation_error
            )
        
        # 3. 缓存检查（幂等工具）
        if schema.idempotent:
            cached = self._get_cached(tool_call.fingerprint)
            if cached:
                logger.debug(f"Cache hit for {tool_name}")
                return cached
        
        # 4-5. 熔断 + 并发控制
        ACTIVE_TOOL_CALLS.labels(tool_name=tool_name).inc()
        start_time = time.time()
        
        try:
            async with self._semaphore:
                result = await self.circuit_breaker.call(
                    tool_name,
                    self._execute_with_retry,
                    tool,
                    tool_call,
                    schema,
                    ctx
                )
            
            # 记录指标
            duration = time.time() - start_time
            TOOL_CALL_DURATION.labels(tool_name=tool_name).observe(duration)
            TOOL_CALLS_TOTAL.labels(tool_name=tool_name, status=result.status).inc()
            
            # 缓存结果
            if schema.idempotent and result.status == "success":
                self._cache_result(tool_call.fingerprint, result, ttl=300)
            
            return result
            
        except CircuitBreakerOpen:
            return ToolResult(
                call_id=tool_call.call_id,
                tool_name=tool_name,
                status="error",
                error_message=f"Circuit breaker open for {tool_name}"
            )
        except Exception as e:
            TOOL_CALLS_TOTAL.labels(tool_name=tool_name, status="error").inc()
            return ToolResult(
                call_id=tool_call.call_id,
                tool_name=tool_name,
                status="error",
                error_message=str(e)
            )
        finally:
            ACTIVE_TOOL_CALLS.labels(tool_name=tool_name).dec()
    
    async def _execute_with_retry(
        self,
        tool: ToolDriver,
        call: ToolCall,
        schema: ToolSchema,
        ctx: ExecutionContext
    ) -> ToolResult:
        """带重试的执行"""
        retry = schema.retry_policy
        max_retries = retry.get("max_retries", 3)
        backoff_base = retry.get("backoff_base_ms", 100)
        backoff_max = retry.get("backoff_max_ms", 10000)
        retryable = set(retry.get("retryable_errors", []))
        
        last_error = None
        
        for attempt in range(max_retries + 1):
            try:
                return await asyncio.wait_for(
                    self.dispatcher.dispatch(tool, call, ctx),
                    timeout=schema.timeout_seconds
                )
            except asyncio.TimeoutError:
                last_error = "timeout"
                if "timeout" not in retryable:
                    break
            except Exception as e:
                error_type = self._classify_error(e)
                last_error = str(e)
                if error_type not in retryable:
                    break
            
            if attempt < max_retries:
                backoff = min(backoff_base * (2 ** attempt), backoff_max)
                logger.warning(f"Retrying {schema.name} in {backoff}ms (attempt {attempt + 1})")
                await asyncio.sleep(backoff / 1000)
        
        return ToolResult(
            call_id=call.call_id,
            tool_name=schema.name,
            status="error",
            error_message=f"Failed after {max_retries + 1} attempts: {last_error}"
        )
    
    def _classify_error(self, error: Exception) -> str:
        """错误分类"""
        msg = str(error).lower()
        if "rate limit" in msg or "429" in msg:
            return "rate_limit"
        elif "timeout" in msg:
            return "timeout"
        elif "connection" in msg or "network" in msg:
            return "transient"
        return "unknown"
    
    def _get_cached(self, fingerprint: str) -> Optional[ToolResult]:
        """获取缓存"""
        if fingerprint not in self._result_cache:
            return None
        
        if time.time() > self._cache_ttl.get(fingerprint, 0):
            del self._result_cache[fingerprint]
            del self._cache_ttl[fingerprint]
            return None
        
        return self._result_cache[fingerprint]
    
    def _cache_result(self, fingerprint: str, result: ToolResult, ttl: int):
        """缓存结果"""
        self._result_cache[fingerprint] = result
        self._cache_ttl[fingerprint] = time.time() + ttl
    
    async def call_batch(
        self,
        calls: List[ToolCall],
        ctx: Optional[ExecutionContext] = None,
        max_parallelism: int = 10
    ) -> List[ToolResult]:
        """批量调用 - 支持并行执行"""
        semaphore = asyncio.Semaphore(max_parallelism)
        
        async def bounded_call(call: ToolCall) -> ToolResult:
            async with semaphore:
                return await self.call(call, ctx)
        
        return await asyncio.gather(*[bounded_call(c) for c in calls])
    
    async def call_chain(
        self,
        calls: List[ToolCall],
        ctx: Optional[ExecutionContext] = None,
        pass_results: bool = True
    ) -> List[ToolResult]:
        """
        链式调用 - 前一个工具的输出作为后一个的输入
        
        例如：搜索 → 读取 → 总结
        """
        results = []
        accumulated = {}
        
        for call in calls:
            if pass_results:
                # 将之前的结果注入参数
                call.arguments = {
                    **call.arguments,
                    "_previous_results": accumulated
                }
            
            result = await self.call(call, ctx)
            results.append(result)
            
            if result.status == "success":
                accumulated[call.tool_name] = result.output
            else:
                # 链断裂
                break
        
        return results
    
    def subscribe_events(self, callback: Callable[[LifeEvent], Any]):
        """订阅事件流"""
        self._event_subscribers.append(callback)
    
    async def _event_pump(self):
        """事件泵 - 持续分发事件"""
        while not self._shutdown_event.is_set():
            try:
                event = await asyncio.wait_for(
                    self._event_queue.get(),
                    timeout=1.0
                )
                for callback in self._event_subscribers:
                    try:
                        if asyncio.iscoroutinefunction(callback):
                            asyncio.create_task(callback(event))
                        else:
                            callback(event)
                    except Exception as e:
                        logger.error(f"Event callback error: {e}")
            except asyncio.TimeoutError:
                continue
    
    async def emit_event(self, event: LifeEvent):
        """发射事件"""
        await self._event_queue.put(event)
    
    async def close(self):
        """优雅关闭"""
        self._state = LifeState.DEAD
        self._shutdown_event.set()
        logger.info("HermesHarness closed")
