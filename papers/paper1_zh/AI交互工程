### 2.7 协作中心 (`src/collaboration/hub.py`)

```python
"""
Collaboration Hub - 人机协作接口
近期：对话式协作
中期：多模态沉浸式协作
远期：神经耦合协作
"""

import asyncio
import logging
from typing import Dict, List, Optional, Any, AsyncIterator
from datetime import datetime
from enum import Enum

from src.core.types import (
    CognitiveContext, Intent, CollaborationMode,
    EntityId, AgentIdentity, ExecutionResult
)

logger = logging.getLogger("cognitive_mesh.collaboration")


class InteractionMode(Enum):
    """交互模式"""
    DIALOGUE = "dialogue"           # 对话式 (近期)
    AMBIENT = "ambient"             # 环境式 (中期)
    IMMERSIVE = "immersive"         # 沉浸式 (中期)
    NEURAL = "neural"               # 神经式 (远期)


class CollaborationHub:
    """
    协作中心 - 人机交互的统一接口
    
    职责：
    1. 接收人类输入（多模态）
    2. 管理交互模式
    3. 协调Agent响应
    4. 反馈收集与适应
    """
    
    def __init__(
        self,
        intent_engine: Any,
        cognitive_core: Any,
        agent_federation: Any,
        context_mesh: Any
    ):
        self.intent_engine = intent_engine
        self.cognitive = cognitive_core
        self.federation = agent_federation
        self.context = context_mesh
        
        # 会话管理
        self._sessions: Dict[str, Dict] = {}
        self._active_collaborations: Dict[str, Any] = {}
        
        # 交互模式配置
        self._mode_transitions = {
            InteractionMode.DIALOGUE: [InteractionMode.AMBIENT],
            InteractionMode.AMBIENT: [InteractionMode.DIALOGUE, InteractionMode.IMMERSIVE],
            InteractionMode.IMMERSIVE: [InteractionMode.AMBIENT, InteractionMode.NEURAL],
            InteractionMode.NEURAL: [InteractionMode.IMMERSIVE]
        }
    
    async def create_session(
        self,
        user_id: str,
        initial_mode: InteractionMode = InteractionMode.DIALOGUE,
        user_profile: Optional[Dict] = None
    ) -> str:
        """创建协作会话"""
        session_id = f"session_{user_id}_{datetime.utcnow().timestamp()}"
        
        # 创建上下文
        ctx = await self.context.create_context(
            initial_signals={
                "user_id": user_id,
                "interaction_mode": initial_mode.value,
                "user_profile": user_profile or {}
            }
        )
        
        self._sessions[session_id] = {
            "context_id": str(ctx.context_id),
            "mode": initial_mode,
            "user_id": user_id,
            "created_at": datetime.utcnow(),
            "collaboration_history": []
        }
        
        return session_id
    
    async def process_input(
        self,
        session_id: str,
        input_data: Dict[str, Any],
        input_type: str = "text"  # text | voice | gesture | neural
    ) -> AsyncIterator[Dict[str, Any]]:
        """
        处理人类输入 - 流式响应
        
        返回异步迭代器，支持实时流式输出
        """
        session = self._sessions.get(session_id)
        if not session:
            raise ValueError(f"Session not found: {session_id}")
        
        # 获取或创建上下文
        ctx_id = EntityId(session["context_id"])
        ctx = await self.context.get_context(ctx_id)
        if not ctx:
            raise ValueError(f"Context not found: {ctx_id}")
        
        # 更新上下文输入
        if input_type == "text":
            ctx.raw_input = input_data.get("text", "")
        elif input_type == "voice":
            # 语音转文本（中期）
            ctx.raw_input = await self._transcribe_voice(input_data)
            ctx.environmental_signals["voice_tone"] = input_data.get("tone")
        elif input_type == "neural":
            # 神经信号解码（远期）
            ctx.raw_input = await self._decode_neural(input_data)
            ctx.neural_signature = input_data.get("signature")
        
        # 更新认知负载
        ctx.cognitive_load = input_data.get("cognitive_load", 0.5)
        
        await self.context.update_context(ctx_id, {
            "raw_input": ctx.raw_input,
            "environmental_signals": ctx.environmental_signals,
            "cognitive_load": ctx.cognitive_load
        })
        
        # 解析意图
        from src.intent.engine import IntentParseRequest
        parse_request = IntentParseRequest(
            raw_input=ctx.raw_input,
            context_id=str(ctx_id)
        )
        
        parse_result = await self.intent_engine.parse(parse_request, ctx)
        
        # 处理不同意图类型
        if parse_result.ambiguity_flags:
            # 需要澄清
            yield {
                "type": "clarification_request",
                "content": parse_result.suggested_clarifications,
                "confidence": parse_result.parsing_confidence
            }
            return
        
        intent = parse_result.intent
        
        # 路由到Agent联邦
        required_caps = await self.intent_engine.route(
            intent,
            []  # 从联邦获取可用能力
        )
        
        # 发现Agent
        agents = await self.federation.discover(
            set(required_caps),
            strategy="trust_weighted"
        )
        
        if not agents:
            yield {
                "type": "error",
                "content": "No suitable agents available"
            }
            return
        
        # 协商协作
        from src.core.types import CollaborationProposal
        proposal = CollaborationProposal(
            proposer=AgentIdentity(name="hub"),
            task_description=intent.raw_text,
            required_capabilities=set(required_caps)
        )
        
        try:
            agreement = await self.federation.negotiate_collaboration(proposal)
        except Exception as e:
            yield {
                "type": "error",
                "content": f"Collaboration negotiation failed: {e}"
            }
            return
        
        # 执行并流式返回
        # 根据交互模式调整输出方式
        mode = session["mode"]
        
        if mode == InteractionMode.DIALOGUE:
            # 近期：对话式输出
            async for chunk in self._dialogue_stream(intent, agreement, ctx):
                yield chunk
        
        elif mode == InteractionMode.AMBIENT:
            # 中期：环境式输出（主动推送）
            async for chunk in self._ambient_stream(intent, agreement, ctx):
                yield chunk
        
        elif mode == InteractionMode.IMMERSIVE:
            # 中期：沉浸式输出（3D/VR）
            async for chunk in self._immersive_stream(intent, agreement, ctx):
                yield chunk
        
        elif mode == InteractionMode.NEURAL:
            # 远期：神经耦合输出
            async for chunk in self._neural_stream(intent, agreement, ctx):
                yield chunk
        
        # 记录协作历史
        session["collaboration_history"].append({
            "timestamp": datetime.utcnow().isoformat(),
            "intent": intent.action,
            "agents": [str(a.agent_id) for a in agreement.participating_agents]
        })
    
    async def _dialogue_stream(
        self,
        intent: Intent,
        agreement: Any,
        ctx: CognitiveContext
    ) -> AsyncIterator[Dict[str, Any]]:
        """对话式流输出"""
        # 生成计划
        plan = await self.cognitive.planning.plan(
            intent,
            intent.constraints,
            []  # 可用能力
        )
        
        yield {
            "type": "plan",
            "content": {
                "steps": len(plan.steps),
                "estimated_time": plan.estimated_duration_ms
            }
        }
        
        # 执行步骤
        for i, step in enumerate(plan.steps):
            yield {
                "type": "progress",
                "content": f"Executing step {i+1}/{len(plan.steps)}: {step.action_type}"
            }
            
            # 实际执行
            result = await self._execute_step(step, agreement)
            
            yield {
                "type": "result",
                "content": result.output,
                "step": i + 1
            }
        
        # 反思（中期）
        if ctx.cognitive_load < 0.7:  # 认知负载低时进行反思
            reflection = await self.cognitive.reflection.reflect(
                ExecutionResult(status="success", output={}),
                plan,
                ctx
            )
            
            yield {
                "type": "reflection",
                "content": reflection.improvement_suggestions
            }
    
    async def _ambient_stream(
        self,
        intent: Intent,
        agreement: Any,
        ctx: CognitiveContext
    ) -> AsyncIterator[Dict[str, Any]]:
        """
        中期功能：环境式流
        
        特点：
        - 主动推送（无需请求）
        - 多模态（视觉+音频+触觉）
        - 情境感知
        """
        # 基于环境信号主动提供信息
        signals = ctx.environmental_signals
        
        if "location" in signals:
            yield {
                "type": "ambient_notification",
                "content": f"Adjusting for location: {signals['location']}"
            }
        
        # 继续对话式流，但更主动
        async for chunk in self._dialogue_stream(intent, agreement, ctx):
            yield chunk
    
    async def _immersive_stream(
        self,
        intent: Intent,
        agreement: Any,
        ctx: CognitiveContext
    ) -> AsyncIterator[Dict[str, Any]]:
        """
        中期功能：沉浸式流
        
        输出3D可视化、空间音频等
        """
        yield {
            "type": "immersive_scene",
            "content": {
                "3d_model": "generated_scene.glb",
                "spatial_audio": "ambient_sound.wav"
            }
        }
    
    async def _neural_stream(
        self,
        intent: Intent,
        agreement: Any,
        ctx: CognitiveContext
    ) -> AsyncIterator[Dict[str, Any]]:
        """
        远期功能：神经耦合流
        
        直接输出神经信号模式
        """
        yield {
            "type": "neural_pattern",
            "content": {
                "resonance_frequency": 40.0,  # Gamma波
                "pattern_id": "cognitive_alignment"
            }
        }
    
    async def _execute_step(self, step: Any, agreement: Any) -> ExecutionResult:
        """执行单步"""
        # 委托给Agent执行
        # 简化实现
        return ExecutionResult(status="success", output={"step": step.action_type})
    
    async def _transcribe_voice(self, audio_data: Dict) -> str:
        """语音转文本（中期）"""
        # 集成Whisper等模型
        return "Transcribed voice input"
    
    async def _decode_neural(self, neural_data: Dict) -> str:
        """神经信号解码（远期）"""
        # 脑机接口信号解码
        return "Decoded neural intent"
    
    async def switch_mode(
        self,
        session_id: str,
        new_mode: InteractionMode
    ) -> bool:
        """切换交互模式"""
        session = self._sessions.get(session_id)
        if not session:
            return False
        
        current = session["mode"]
        if new_mode not in self._mode_transitions.get(current, []):
            logger.warning(f"Invalid mode transition: {current} -> {new_mode}")
            return False
        
        session["mode"] = new_mode
        
        # 更新上下文
        ctx_id = EntityId(session["context_id"])
        await self.context.update_context(ctx_id, {
            "environmental_signals": {
                "interaction_mode": new_mode.value
            }
        })
        
        return True
    
    async def collect_feedback(
        self,
        session_id: str,
        feedback: Dict[str, Any]
    ):
        """
        收集反馈用于强化学习
        
        feedback: {
            "rating": 1-5,
            "corrections": [...],
            "preference_signals": {...}
        }
        """
        session = self._sessions.get(session_id)
        if not session:
            return
        
        # 更新Agent信任分
        for agent_id in session.get("last_agents", []):
            await self.federation.update_trust(
                EntityId(agent_id),
                feedback.get("rating", 3) > 3,
                feedback.get("rating", 3) / 5.0
            )
        
        # 存储反馈用于模型微调
        # ...
    
    async def close_session(self, session_id: str):
        """关闭会话"""
        session = self._sessions.pop(session_id, None)
        if session:
            # 清理上下文
            await self.context.update_context(
                EntityId(session["context_id"]),
                {"status": "closed"}
            )
