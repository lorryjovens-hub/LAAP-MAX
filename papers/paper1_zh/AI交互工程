        # 调度
        self._scheduler_task: Optional[asyncio.Task] = None
        self._shutdown_event = asyncio.Event()
        
        # 指标
        self._total_tasks_processed = 0
        self._system_start_time = asyncio.get_event_loop().time()
    
    async def gestate(self):
        """系统孕育 - 初始化所有组件"""
        logger.info("Lifeform gestation beginning...")
        
        # 1. 初始化 Harness
        await self._harness.initialize()
        
        # 2. 注册内置工具
        await self._register_builtin_tools()
        
        # 3. 孵化初始种群
        await self._spawn_initial_population()
        
        # 4. 启动调度器
        self._scheduler_task = asyncio.create_task(self._scheduler_loop())
        
        self._system_state = LifeState.ALIVE
        logger.info("Lifeform is ALIVE")
    
    async def _register_builtin_tools(self):
        """注册内置工具"""
        from src.hermes.tools.builtins import (
            CodeExecutionTool, FileSystemTool, LLMCallTool, WebSearchTool
        )
        
        # 创建共享工具实例
        fs_tool = FileSystemTool(allowed_paths=["/tmp", "/workspace"])
        code_tool = CodeExecutionTool()
        search_tool = WebSearchTool()
        
        # 注册到 harness（全局可用）
        await self._harness.registry.register(fs_tool)
        await self._harness.registry.register(code_tool)
        await self._harness.registry.register(search_tool)
        
        logger.info(f"Registered {len(self._harness.registry.list_all())} builtin tools")
    
    async def _spawn_initial_population(self):
        """孵化初始 Agent 种群"""
        roles = [
            (AgentRole.ORCHESTRATOR, {"name": "alpha", "capabilities": {"planning", "coordination"}}),
            (AgentRole.WORKER, {"name": "beta", "capabilities": {"code_generation", "execution"}}),
            (AgentRole.WORKER, {"name": "gamma", "capabilities": {"analysis", "search"}}),
            (AgentRole.GUARDIAN, {"name": "delta", "capabilities": {"security", "audit"}}),
            (AgentRole.OBSERVER, {"name": "epsilon", "capabilities": {"monitoring", "telemetry"}}),
        ]
        
        for role, config in roles:
            agent = await self._nursery.create_agent(
                name=config["name"],
                role=role,
                capabilities=config["capabilities"],
                config={"autonomy_level": 0.5}
            )
            
            # 绑定工具
            for tool_name in self._harness.registry.list_all():
                tool = self._harness.registry.get(tool_name.name)
                if tool:
                    await agent.bind_tool(tool)
        
        logger.info(f"Spawned initial population of {len(roles)} agents")
    
    async def submit_task(self, intent: str, **kwargs) -> str:
        """
        提交任务到生命体
        
        1. 意图解析
        2. Agent 选择
        3. 任务分发
        4. 返回追踪ID
        """
        task = Task(
            intent=intent,
            goal_state=kwargs.get("goal_state"),
            constraints=kwargs.get("constraints", []),
            priority=kwargs.get("priority", 5)
        )
        
        # 选择最合适的 Agent
        agent = await self._select_agent(task)
        if not agent:
            raise RuntimeError("No suitable agent available")
        
        # 分发
        agent.enqueue_task(task)
        self._total_tasks_processed += 1
        
        return str(task.task_id)
    
    async def _select_agent(self, task: Task) -> Optional[AgentCell]:
        """Agent 选择策略"""
        agents = await self._nursery.list_agents()
        
        # 过滤可用 Agent
        candidates = []
        for profile in agents:
            if profile.state not in (LifeState.ALIVE, LifeState.STRESSED):
                continue
            
            # 能力匹配
            task_caps = set(task.constraints)  # 简化
            match_score = len(profile.capabilities & task_caps)
            
            # 负载考量
            load_penalty = profile.vital_signs.task_queue_depth * 0.1
            
            score = match_score - load_penalty
            candidates.append((score, profile))
        
        if not candidates:
            return None
        
        # 选择最高分
        candidates.sort(key=lambda x: x[0], reverse=True)
        best_id = str(candidates[0][1].agent_id)
        
        return await self._nursery.get_agent(best_id)
    
    async def _scheduler_loop(self):
        """调度循环 - 生命维持"""
        while not self._shutdown_event.is_set():
            try:
                await asyncio.wait_for(
                    self._shutdown_event.wait(),
                    timeout=10.0
                )
            except asyncio.TimeoutError:
                await self._lifeform_maintenance()
    
    async def _lifeform_maintenance(self):
        """生命体维护"""
        status = await self._nursery.get_federation_status()
        current = status["total_agents"]
        
        # 自动扩缩容
        if current < self._min_population:
            # 需要扩容
            await self._spawn_worker()
        elif current > self._max_population:
            # 需要缩容
            await self._cull_weakest()
        
        # 健康检查
        for agent_id in list(self._nursery._agents.keys()):
            agent = await self._nursery.get_agent(agent_id)
            if agent and agent.profile.state == LifeState.DEAD:
                # 清理死亡 Agent
                await self._nursery.kill_agent(agent_id)
                # 补充
                await self._spawn_worker()
        
        # 系统级事件发射
        await self._harness.emit_event(LifeEvent(
            event_type="system_pulse",
            source_id=LifeID("system"),
            payload={
                "population": current,
                "tasks_processed": self._total_tasks_processed,
                "uptime_seconds": asyncio.get_event_loop().time() - self._system_start_time
            }
        ))
    
    async def _spawn_worker(self):
        """生成工作者"""
        worker = await self._nursery.create_agent(
            name=f"worker_{asyncio.get_event_loop().time()}",
            role=AgentRole.WORKER,
            capabilities={"execution", "general"},
            config={"autonomy_level": 0.3}
        )
        logger.info(f"Spawned worker {worker.profile.name}")
    
    async def _cull_weakest(self):
        """淘汰最弱的 Agent"""
        agents = await self._nursery.list_agents()
        if len(agents) <= self._min_population:
            return
        
        # 按健康分排序
        agents.sort(key=lambda a: a.vital_signs.health_score)
        weakest = agents[0]
        
        await self._nursery.kill_agent(str(weakest.agent_id))
        logger.info(f"Culled weakest agent {weakest.name}")
    
    async def get_system_status(self) -> Dict[str, Any]:
        """获取系统状态"""
        return {
            "state": self._system_state.value,
            "agents": await self._nursery.get_federation_status(),
            "tools": len(self._harness.registry.list_all()),
            "tasks_processed": self._total_tasks_processed,
            "uptime_seconds": asyncio.get_event_loop().time() - self._system_start_time
        }
    
    async def apoptosis(self):
        """程序性死亡 - 优雅关闭整个系统"""
        logger.info("Initiating system apoptosis...")
        self._system_state = LifeState.DEAD
        self._shutdown_event.set()
        
        if self._scheduler_task:
            self._scheduler_task.cancel()
        
        # 终止所有 Agent
        for agent_id in list(self._nursery._agents.keys()):
            await self._nursery.kill_agent(agent_id)
        
        # 关闭 Harness
        await self._harness.close()
        
        logger.info("Lifeform apoptosis complete")
