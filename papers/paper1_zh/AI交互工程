        # 生成回滚策略
        rollback = self._generate_rollback(steps)
        
        return ExecutionPlan(
            plan_id=EntityId("plan"),
            intent_id=intent.intent_id,
            steps=steps,
            estimated_duration_ms=sum(s.timeout_seconds * 1000 for s in steps),
            resource_requirements=self._estimate_resources(steps),
            rollback_strategy=rollback,
            verification_checkpoint=[i for i in range(len(steps))]
        )
    
