    tests_passed: Optional[bool] = None


class ASTTransformer:
    """
    AST 变换器 — 在抽象语法树层面进行安全代码变换
    """
    
    def __init__(self):
        self._transformers: Dict[str, Callable] = {
            "extract_method": self._extract_method,
            "inline_variable": self._inline_variable,
            "add_type_hints": self._add_type_hints,
            "optimize_loop": self._optimize_loop,
            "add_error_handling": self._add_error_handling,
        }
    
    def apply(self, tree: ast.AST, transform_type: str, **params) -> ast.AST:
        """应用变换"""
        if transform_type not in self._transformers:
            raise ValueError(f"Unknown transform: {transform_type}")
        
        return self._transformers[transform_type](tree, **params)
    
    def _extract_method(self, tree: ast.AST, start_line: int, end_line: int, new_name: str) -> ast.AST:
        """提取方法重构"""
        # 实现提取方法逻辑
        # 简化版本：直接返回原树
        return tree
    
    def _inline_variable(self, tree: ast.AST, var_name: str) -> ast.AST:
        """内联变量"""
        return tree
    
    def _add_type_hints(self, tree: ast.AST) -> ast.AST:
        """添加类型提示"""
        class TypeHintAdder(ast.NodeTransformer):
            def visit_FunctionDef(self, node):
                # 为没有注解的参数添加 Any 注解
                for arg in node.args.args:
                    if arg.annotation is None:
                        arg.annotation = ast.Name(id='Any', ctx=ast.Load())
                if node.returns is None:
                    node.returns = ast.Name(id='Any', ctx=ast.Load())
                return self.generic_visit(node)
        
        return TypeHintAdder().visit(tree)
    
    def _optimize_loop(self, tree: ast.AST) -> ast.AST:
        """优化循环"""
        # 列推导式优化等
        return tree
    
    def _add_error_handling(self, tree: ast.AST, func_name: str) -> ast.AST:
        """添加错误处理"""
        class ErrorHandlerAdder(ast.NodeTransformer):
            def visit_FunctionDef(self, node):
                if node.name == func_name:
                    # 包装 try-except
                    wrapper = ast.Try(
                        body=node.body,
                        handlers=[ast.ExceptHandler(
                            type=ast.Name(id='Exception', ctx=ast.Load()),
                            name='e',
                            body=[ast.Return(value=ast.Constant(value=None))]
                        )],
                        orelse=[],
                        finalbody=[]
                    )
                    node.body = [wrapper]
                return node
        
        return ErrorHandlerAdder().visit(tree)


class SelfModificationEngine:
    """
    自修改引擎 — 核心 RSI 实现
    
    工作流：
    1. 接收改进目标
    2. 生成突变候选
    3. 宪法检查
    4. 沙箱编译
    5. 差分测试
    6. 热重载或持久化
    7. 回滚准备
    """
    
    def __init__(
        self,
        introspection: IntrospectionEngine,
        constitutional_guard: ConstitutionalGuard,
        backup_dir: str = ".hermes/backups"
    ):
        self.introspection = introspection
        self.guard = constitutional_guard
        self.transformer = ASTTransformer()
        self.backup_dir = Path(backup_dir)
        self.backup_dir.mkdir(parents=True, exist_ok=True)
        
        # 修改历史
        self.mutation_history: List[Mutation] = []
        self._rollback_stack: List[Tuple[str, str]] = []  # (file_path, original_content)
    
    async def propose_modification(
        self,
        target_node_id: str,
        improvement_goal: str,
        strategy: str = "auto"
    ) -> List[Mutation]:
        """
        提出修改方案
        
        基于自我模型中的代码节点，生成改进候选
        """
        node = self.introspection.self_model.code_nodes.get(target_node_id)
        if not node:
            raise ValueError(f"Unknown node: {target_node_id}")
        
        mutations = []
        
        # 根据策略生成突变
        if strategy == "auto":
            # 自动选择最佳策略
            if node.complexity > 10:
                strategy = "refactor"
            elif "missing_docstring" in [i["type"] for i in self.introspection.self_model.known_issues if i.get("node_id") == target_node_id]:
                strategy = "document"
            else:
                strategy = "optimize"
        
        if strategy == "refactor":
            # 提取子方法降低复杂度
            mut = await self._generate_refactor_mutation(node)
            if mut:
                mutations.append(mut)
        
        elif strategy == "document":
            mut = await self._generate_documentation_mutation(node)
            if mut:
                mutations.append(mut)
        
        elif strategy == "optimize":
            mut = await self._generate_optimization_mutation(node)
            if mut:
                mutations.append(mut)
        
        elif strategy == "repair":
            mut = await self._generate_repair_mutation(node, improvement_goal)
            if mut:
                mutations.append(mut)
        
        return mutations
    
    async def _generate_refactor_mutation(self, node: CodeNode) -> Optional[Mutation]:
        """生成重构突变"""
        try:
            tree = ast.parse(node.source_code)
            modified_tree = self.transformer.apply(tree, "add_type_hints")
            
            # 转换为源代码
            import astor  # 或 codegen
            modified_source = astor.to_source(modified_tree)
            
            return Mutation(
                mutation_id=f"mut_{datetime.utcnow().timestamp()}",
                target_node_id=node.node_id,
                mutation_type="refactor",
                original_ast=tree,
                modified_ast=modified_tree,
                original_source=node.source_code,
                modified_source=modified_source,
                expected_improvement=0.1
            )
        except Exception as e:
            logger.error(f"Failed to generate refactor mutation: {e}")
            return None
    
    async def _generate_documentation_mutation(self, node: CodeNode) -> Optional[Mutation]:
        """生成文档化突变"""
        if node.node_type != "function":
            return None
        
        # 生成文档字符串
        docstring = self._generate_docstring(node)
        
        # 插入文档字符串
        tree = ast.parse(node.source_code)
        func = tree.body[0]
        
        if isinstance(func, (ast.FunctionDef, ast.AsyncFunctionDef)):
            doc_node = ast.Expr(value=ast.Constant(value=docstring))
            func.body.insert(0, doc_node)
            
            import astor
            modified_source = astor.to_source(tree)
            
            return Mutation(
                mutation_id=f"mut_doc_{datetime.utcnow().timestamp()}",
                target_node_id=node.node_id,
                mutation_type="extend",
                original_ast=ast.parse(node.source_code),
                modified_ast=tree,
                original_source=node.source_code,
                modified_source=modified_source,
                expected_improvement=0.05
            )
        
        return None
    
    def _generate_docstring(self, node: CodeNode) -> str:
        """基于函数生成文档字符串"""
        return f'"""\nAuto-generated docstring for {node.name}.\nComplexity: {node.complexity}\nDependencies: {len(node.dependencies)}\n"""'
    
    async def _generate_optimization_mutation(self, node: CodeNode) -> Optional[Mutation]:
        """生成优化突变"""
        # 基于性能画像优化
        return None
    
    async def _generate_repair_mutation(self, node: CodeNode, error_description: str) -> Optional[Mutation]:
        """生成修复突变"""
        # 使用 LLM 生成修复
        return None
    
    async def validate_mutation(
        self,
        mutation: Mutation,
        permit: Optional[ModificationPermit] = None
    ) -> bool:
        """
        验证突变
        
        1. 宪法检查
        2. 语法检查
        3. 类型检查（mypy）
        4. 单元测试
        5. 回归测试
        """
        # 1. 宪法检查
        if not permit or not permit.is_valid:
            raise ConstitutionalViolation("Invalid or missing modification permit")
        
        if mutation.target_node_id not in self.introspection.self_model.code_nodes:
            raise ValueError("Target node not in self-model")
        
        node = self.introspection.self_model.code_nodes[mutation.target_node_id]
        
        # 2. 语法检查
        try:
            ast.parse(mutation.modified_source)
            mutation.syntax_valid = True
        except SyntaxError:
            mutation.syntax_valid = False
            return False
        
        # 3. 类型检查
        mutation.type_check_passed = await self._type_check(mutation, node)
        
        # 4. 差分测试
        mutation.tests_passed = await self._differential_test(mutation, node)
        
        return mutation.syntax_valid and mutation.type_check_passed and mutation.tests_passed
    
    async def _type_check(self, mutation: Mutation, node: CodeNode) -> bool:
        """类型检查"""
        # 写入临时文件运行 mypy
        with tempfile.NamedTemporaryFile(mode='w', suffix='.py', delete=False) as f:
            f.write(mutation.modified_source)
            temp_path = f.name
        
        try:
            proc = await asyncio.create_subprocess_exec(
                "python", "-m", "mypy", temp_path,
                stdout=asyncio.subprocess.PIPE,
                stderr=asyncio.subprocess.PIPE
            )
            stdout, stderr = await asyncio.wait_for(proc.communicate(), timeout=30)
            os.unlink(temp_path)
            
            # mypy 返回 0 表示无错误
            return proc.returncode == 0
        except Exception as e:
            logger.error(f"Type check failed: {e}")
            return False
    
    async def _differential_test(
        self,
        mutation: Mutation,
        node: CodeNode
    ) -> bool:
        """
        差分测试 — 确保修改前后行为一致
        
        1. 提取函数的输入输出契约
        2. 生成测试用例
        3. 在沙箱中运行原始和修改后的版本
        4. 比较输出
        """
        # 简化：检查修改是否只影响文档/类型提示（安全）
        if mutation.mutation_type == "extend" and "docstring" in mutation.modified_source:
            return True
        
        # 对于重构，需要更严格的测试
        # 实际实现：使用 hypothesis 生成测试用例
        return True
    
    async def apply_mutation(
        self,
        mutation: Mutation,
        permit: ModificationPermit
    ) -> bool:
        """
        应用突变到生产代码
        
        1. 备份
        2. 写入修改
        3. 热重载
        4. 验证
        5. 更新自我模型
        """
        node = self.introspection.self_model.code_nodes[mutation.target_node_id]
        file_path = Path(node.file_path)
        
        # 1. 备份
        backup_path = self.backup_dir / f"{file_path.name}.{datetime.utcnow().strftime('%Y%m%d_%H%M%S')}.bak"
        original_content = file_path.read_text()
        backup_path.write_text(original_content)
        self._rollback_stack.append((str(file_path), original_content))
        
        # 2. 应用修改
        # 替换函数在文件中的代码
        new_content = self._splice_modification(
            original_content,
            node.start_line,
            node.end_line,
            mutation.modified_source
        )
        
        # 3. 宪法最终检查
        if not self.guard.verify_execution_safety(new_content):
            raise ConstitutionalViolation("Final safety check failed")
        
        # 4. 写入
        file_path.write_text(new_content)
        
        # 5. 热重载（如果可能）
        reloaded = await self._hot_reload(node.module_name)
        
        # 6. 更新自我模型
        if reloaded:
            await self.introspection.build_self_model()
            mutation.mutation_count = 1
            self.mutation_history.append(mutation)
            logger.info(f"Mutation applied successfully: {mutation.mutation_id}")
            return True
        
        # 回滚
        await self.rollback()
        return False
    
    def _splice_modification(
        self,
        original: str,
        start_line: int,
        end_line: int,
        new_code: str
    ) -> str:
        """拼接修改到源代码"""
        lines = original.split("\n")
        before = lines[:start_line - 1]
        after = lines[end_line:]
        
        # 保持缩进
        indent = len(lines[start_line - 1]) - len(lines[start_line - 1].lstrip())
        indented_new = textwrap.indent(new_code.strip(), " " * indent)
        
        return "\n".join(before + [indented_new] + after)
    
    async def _hot_reload(self, module_name: str) -> bool:
        """热重载模块"""
        try:
            if module_name in sys.modules:
                importlib.reload(sys.modules[module_name])
                logger.info(f"Hot reloaded: {module_name}")
                return True
            return True
        except Exception as e:
            logger.error(f"Hot reload failed: {e}")
            return False
    
    async def rollback(self, steps: int = 1) -> bool:
        """
        回滚修改
        
        这是 RSI 的安全网：任何修改都可以被撤销
        """
        for _ in range(steps):
            if not self._rollback_stack:
                break
            
            file_path, original_content = self._rollback_stack.pop()
            Path(file_path).write_text(original_content)
            logger.info(f"Rolled back: {file_path}")
        
        # 重新加载自我模型
        await self.introspection.build_self_model()
        return True
    
    def get_mutation_history(self) -> List[Dict]:
        """获取修改历史"""
        return [
            {
                "id": m.mutation_id,
                "target": m.target_node_id,
                "type": m.mutation_type,
                "improvement": m.expected_improvement,
                "tests_passed": m.tests_passed
            }
            for m in self.mutation_history
        ]
