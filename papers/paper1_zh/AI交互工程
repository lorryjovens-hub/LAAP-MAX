    plan_id: str
    name: str
    phase: str
    overall_progress: float
    tasks_completed: int
    tasks_total: int
    domains: Dict[str, float]
    estimated_completion: Optional[str]
    team: List[str]


class TaskActionRequest(BaseModel):
    action: str  # "pause", "resume", "cancel", "retry"


# ─────────────────────────────────────────────────────────────────────────────
# 生命周期
# ─────────────────────────────────────────────────────────────────────────────

@asynccontextmanager
async def lifespan(app: FastAPI):
    # 启动
    app.state.harness = HermesHarness()
    await app.state.harness.initialize()
    
    app.state.nursery = AgentNursery(app.state.harness)
    app.state.longhaul = LongHaulEngine()
    app.state.swarm = SwarmOrchestrator(app.state.longhaul, app.state.nursery)
    
    yield
    
    # 关闭
    await app.state.harness.close()


app = FastAPI(
    title="Hermes LongHaul API",
    version="2.0.0",
    lifespan=lifespan
)

app.add_middleware(
    CORSMiddleware,
    allow_origins=["http://localhost:3000"],
    allow_credentials=True,
    allow_methods=["*"],
    allow_headers=["*"],
)


# ─────────────────────────────────────────────────────────────────────────────
# API 路由
# ─────────────────────────────────────────────────────────────────────────────

@app.post("/api/v1/projects", response_model=Dict[str, str])
async def create_project(req: CreateProjectRequest):
    """创建新项目"""
    plan_id = await app.state.swarm.initiate_project(
        project_name=req.name,
        requirements=req.requirements,
        tech_stack=req.tech_stack
    )
    
    # 异步启动执行
    asyncio.create_task(app.state.swarm.execute_project(plan_id))
    
    return {"plan_id": plan_id, "status": "initiated"}


@app.get("/api/v1/projects/{plan_id}/status", response_model=Dict[str, Any])
async def get_project_status(plan_id: str):
    """获取项目状态"""
    status = await app.state.longhaul.get_plan_status(plan_id)
    if "error" in status:
        raise HTTPException(status_code=404, detail=status["error"])
    return status


@app.get("/api/v1/projects/{plan_id}/dashboard", response_model=Dict[str, Any])
async def get_project_dashboard(plan_id: str):
    """获取项目仪表盘数据"""
    dashboard = await app.state.swarm.get_project_dashboard(plan_id)
    return dashboard


@app.post("/api/v1/projects/{plan_id}/action")
async def project_action(plan_id: str, req: TaskActionRequest):
    """项目操作"""
    if req.action == "pause":
        await app.state.longhaul.pause_plan(plan_id)
    elif req.action == "resume":
        await app.state.longhaul.resume_plan(plan_id)
    
    return {"status": "ok", "action": req.action}


@app.get("/api/v1/projects/current/status")
async def get_current_project():
    """获取当前活跃项目（供前端使用）"""
    # 返回第一个活跃项目
    for plan_id in app.state.swarm._active_projects:
        return await get_project_status(plan_id)
    return {"error": "No active project"}


@app.get("/health")
async def health():
    return {"status": "healthy", "timestamp": datetime.utcnow().isoformat()}
