    error_rate_1m: float = 0.0
    latency_p99_ms: float = 0.0
    last_heartbeat: datetime = field(default_factory=datetime.utcnow)
    
    @property
    def health_score(self) -> float:
        """健康评分 0-1"""
        if self.error_rate_1m > 0.1 or self.latency_p99_ms > 5000:
            return 0.0
        return max(0.0, 1.0 - (
            self.cpu_usage * 0.2 +
            self.memory_usage * 0.2 +
            self.error_rate_1m * 5.0 +
            min(self.latency_p99_ms / 10000, 1.0) * 0.2
