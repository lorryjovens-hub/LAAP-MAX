            code=raw_code,
            prompt=prompt,
            verification_level=verification_level
        )
        
        if not passed:
            self._cal_stats["hallucinations_blocked"] += 1
            logger.warning(f"Code generation failed validation: {reports}")
            return {
                "success": False,
                "code": None,
                "reports": [r.__dict__ for r in reports],
                "cost": result["cost"]
            }
        
        final_code = fixed or raw_code
        
        # 5. 存储到记忆
        await self.memory.add_to_working_memory(
            self._create_chunk(f"Generated code for: {intent}", tags={"code_generation"})
        )
        
        return {
            "success": True,
            "code": final_code,
            "reports": [r.__dict__ for r in reports],
            "cost": result["cost"],
            "model": result["model"]
        }
    
    def _create_chunk(self, content: str, tags: set = None):
        from src.hermes.cal.context_weave import MemoryChunk
        return MemoryChunk(
            chunk_id=f"chunk_{hashlib.md5(content.encode()).hexdigest()[:8]}",
            content=content,
            memory_type="episodic",
            tags=tags or set(),
            token_count=len(content.split())
        )
    
    async def get_cal_stats(self) -> Dict[str, Any]:
        """获取 CAL 统计"""
        return {
            **self._cal_stats,
            "shield_stats": self.shield.get_stats(),
            "token_savings": self.token_econ.get_savings_report(),
            "memory_stats": {
                "working_memory_size": len(self.memory.working_memory)
            }
        }
