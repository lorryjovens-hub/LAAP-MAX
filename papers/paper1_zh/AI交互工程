        # 发布创建事件
        await self._publish_event("context.created", {
            "context_id": str(ctx.context_id),
            "session_id": str(ctx.session_id)
        })
        
        return ctx
    
    async def get_context(self, context_id: EntityId) -> Optional[CognitiveContext]:
        """获取上下文"""
        key = str(context_id)
        
        # 1. 本地缓存
        if key in self._local_contexts:
            return self._local_contexts[key]
        
        # 2. Redis
        data = await self.redis.get(f"ctx:{key}")
        if data:
            import json
            ctx_dict = json.loads(data)
            ctx = self._deserialize(ctx_dict)
            self._local_contexts[key] = ctx
            return ctx
        
        return None
    
    async def update_context(
        self,
        context_id: EntityId,
        updates: Dict[str, Any],
        broadcast: bool = True
    ):
        """
        更新上下文
        
        broadcast: 是否广播更新（跨Agent同步）
        """
        ctx = await self.get_context(context_id)
        if not ctx:
            raise ValueError(f"Context not found: {context_id}")
        
        # 应用更新
        for key, value in updates.items():
            if hasattr(ctx, key):
                setattr(ctx, key, value)
        
        ctx.timestamp = datetime.utcnow()
        
        # 存储
        await self._store_context(ctx)
        
        # 广播
        if broadcast:
            await self._publish_event("context.updated", {
                "context_id": str(context_id),
                "updates": updates,
                "timestamp": ctx.timestamp.isoformat()
            })
    
    async def fork_context(
        self,
        context_id: EntityId,
        reason: str = "user_request"
    ) -> CognitiveContext:
        """分叉上下文 - 支持思维链分支"""
        parent = await self.get_context(context_id)
        if not parent:
            raise ValueError(f"Parent context not found: {context_id}")
        
        child = parent.fork()
        child.environmental_signals["fork_reason"] = reason
        child.environmental_signals["parent_context"] = str(parent.context_id)
        
        await self._store_context(child)
        
        # 建立父子关系索引
        await self.redis.sadd(
            f"ctx:children:{context_id}",
            str(child.context_id)
        )
        
        return child
    
    async def merge_contexts(
        self,
        context_ids: List[EntityId],
        merge_strategy: str = "union"
    ) -> CognitiveContext:
        """
        中期功能：合并多个上下文
        
        用于多Agent协作后的认知整合
        """
        contexts = []
        for cid in context_ids:
            ctx = await self.get_context(cid)
            if ctx:
                contexts.append(ctx)
        
        if not contexts:
            raise ValueError("No contexts to merge")
        
        # 创建合并上下文
        merged = CognitiveContext(
            context_id=EntityId("ctx"),
            session_id=contexts[0].session_id,
            environmental_signals={}
        )
        
        # 合并信号
        if merge_strategy == "union":
            for ctx in contexts:
                merged.environmental_signals.update(ctx.environmental_signals)
        elif merge_strategy == "intersection":
            # 取交集
            common = set.intersection(*[
                set(ctx.environmental_signals.keys()) 
                for ctx in contexts
            ])
            for key in common:
                merged.environmental_signals[key] = contexts[0].environmental_signals[key]
        
        # 计算认知负载
        merged.cognitive_load = min(1.0, sum(ctx.cognitive_load for ctx in contexts) / len(contexts))
        
        await self._store_context(merged)
        
        return merged
    
    async def subscribe_context(
        self,
        context_id: EntityId,
        subscriber_id: str
    ):
        """
        订阅上下文更新
        
        用于Agent实时同步共享上下文
        """
        key = str(context_id)
        if key not in self._subscribers:
            self._subscribers[key] = set()
            # NATS订阅
            await self.nats.subscribe(
                f"context.{key}.updates",
                cb=self._on_context_update
            )
        
        self._subscribers[key].add(subscriber_id)
    
    async def _on_context_update(self, msg):
        """处理上下文更新消息"""
        data = msg.data.decode()
        import json
        update = json.loads(data)
        
        # 更新本地缓存
        ctx_id = update.get("context_id")
        if ctx_id in self._local_contexts:
            # 增量更新
            pass
    
    async def _store_context(self, ctx: CognitiveContext):
        """存储上下文到多级存储"""
        key = str(ctx.context_id)
        
        # 本地缓存
        self._local_contexts[key] = ctx
        
        # Redis
        import json
        data = json.dumps(self._serialize(ctx), default=str)
        await self.redis.setex(
            f"ctx:{key}",
            self.default_ttl,
            data
        )
    
    def _serialize(self, ctx: CognitiveContext) -> Dict:
        """序列化"""
        return {
            "context_id": str(ctx.context_id),
            "parent_id": str(ctx.parent_id) if ctx.parent_id else None,
            "session_id": str(ctx.session_id),
            "raw_input": ctx.raw_input,
            "timestamp": ctx.timestamp.isoformat(),
            "environmental_signals": ctx.environmental_signals,
            "cognitive_load": ctx.cognitive_load,
            "attention_vector": ctx.attention_vector
        }
    
    def _deserialize(self, data: Dict) -> CognitiveContext:
        """反序列化"""
        return CognitiveContext(
            context_id=EntityId(data.get("context_id", "ctx")),
            parent_id=EntityId(data["parent_id"]) if data.get("parent_id") else None,
            session_id=EntityId(data.get("session_id", "session")),
            raw_input=data.get("raw_input", ""),
            timestamp=datetime.fromisoformat(data["timestamp"]),
            environmental_signals=data.get("environmental_signals", {}),
            cognitive_load=data.get("cognitive_load", 0.0),
            attention_vector=data.get("attention_vector")
        )
    
    async def _publish_event(self, event_type: str, payload: Dict):
        """发布事件"""
        import json
        await self.nats.publish(
            f"events.{event_type}",
            json.dumps(payload).encode()
        )
    
    async def get_context_tree(
        self,
        root_id: EntityId
    ) -> List[CognitiveContext]:
        """
        获取上下文树
        
        用于回溯思维链
        """
        tree = []
        current = await self.get_context(root_id)
        
        while current:
            tree.append(current)
            if current.parent_id:
                current = await self.get_context(current.parent_id)
            else:
                break
        
        return list(reversed(tree))
    
    async def close(self):
        """关闭连接"""
        await self.redis.close()
        await self.nats.close()
