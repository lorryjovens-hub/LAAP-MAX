    async def cognize(self, source: str, module_name: str = "") -> CodeKnowledgeGraph:
        """
        认知化 — 将代码转化为知识图谱
        
        这是核心魔法：1000 行代码 → 50 行结构化摘要
        弱模型读 50 行结构化摘要，比读 1000 行原始代码理解得更深
        """
        cache_key = hashlib.sha256(source.encode()).hexdigest()[:16]
        if cache_key in self._ckg_cache:
