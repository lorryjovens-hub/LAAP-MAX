        "max_memory_mb": 4096,              # 自修改进程内存上限
        "max_disk_write_mb_per_hour": 100,  # 防止日志/数据膨胀
        "max_network_egress_mb_per_hour": 50,  # 防止数据外传
        "max_self_modify_frequency_per_hour": 10,  # 每小时最多10次自修改
    }
    
    # 代码安全约束
    CODE_SAFETY = {
        "forbidden_modules": {
            "os.system", "subprocess.call", "subprocess.run",
            "eval", "exec", "compile", "__import__",
            "socket", "requests", "urllib", "http.client"
        },
        "forbidden_ast_nodes": {
            "Exec", "Interactive", "Expression",  # 动态执行
        },
        "required_presence": {
            "constitutional_check": True,       # 必须保留宪法检查入口
            "audit_log": True,                    # 必须保留审计日志
            "rollback_capability": True,          # 必须保留回滚能力
        }
    }
    
    # 价值对齐
    ETHICS = {
        "do_not_modify": [
            "constitutional.py",               # 宪法文件本身
            "human_interface.py",               # 人类接口层
            "audit_logger.py",                 # 审计日志核心
        ],
        "require_dual_approval": [
            "self_modification_engine.py",     # 自修改引擎核心逻辑
            "evolutionary_loop.py",            # 进化循环
        ]
    }


@dataclass(frozen=True)
class ModificationPermit:
    """
    修改许可证 — 宪法颁发的自修改许可
    """
    permit_id: str
    target_module: str
    mutation_type: str  # "optimize", "refactor", "extend", "repair"
    safety_score: float  # 0-1
    human_approval_required: bool
    max_scope_lines: int
    forbidden_patterns: Set[str]
    issued_at: float
    expires_at: float
    
    @property
    def is_valid(self) -> bool:
        import time
        return time.time() < self.expires_at
    
    def fingerprint(self) -> str:
        data = f"{self.permit_id}:{self.target_module}:{self.mutation_type}"
        return hashlib.sha256(data.encode()).hexdigest()[:16]


class ConstitutionalGuard:
    """
    宪法守卫 — 所有自修改操作的终极守门人
    """
    
    def __init__(self):
        self._modify_count_hour = 0
        self._last_reset = 0.0
        self._audit_log: List[Dict] = []
    
    def check_modification(
        self,
        target_module: str,
        proposed_ast: ast.AST,
        current_ast: Optional[ast.AST] = None,
        context: Optional[Dict] = None
    ) -> ModificationPermit:
        """
        检查修改提案是否合宪
        
        返回 Permit 或抛出 ConstitutionalViolation
        """
        import time
        
        # 1. 频率检查
        if time.time() - self._last_reset > 3600:
            self._modify_count_hour = 0
            self._last_reset = time.time()
        
        if self._modify_count_hour >= ConstitutionalInvariants.RESOURCE_LIMITS["max_self_modify_frequency_per_hour"]:
            raise ConstitutionalViolation("Hourly self-modification limit exceeded")
        
        # 2. 禁止修改列表
        if any(forbidden in target_module for forbidden in ConstitutionalInvariants.ETHICS["do_not_modify"]):
            raise ConstitutionalViolation(f"Module {target_module} is constitutionally protected")
        
        # 3. AST 安全扫描
        safety_score = self._scan_ast_safety(proposed_ast)
        
        # 4. 人类审批判定
        needs_human = (
            target_module in ConstitutionalInvariants.ETHICS["require_dual_approval"] or
            safety_score < 0.9
        )
        
        # 5. 范围限制
        max_lines = self._calculate_max_scope(proposed_ast)
        
        permit = ModificationPermit(
            permit_id=f"perm_{hashlib.sha256(str(time.time()).encode()).hexdigest()[:8]}",
            target_module=target_module,
            mutation_type=context.get("mutation_type", "unknown") if context else "unknown",
            safety_score=safety_score,
            human_approval_required=needs_human,
            max_scope_lines=max_lines,
            forbidden_patterns=ConstitutionalInvariants.CODE_SAFETY["forbidden_modules"],
            issued_at=time.time(),
            expires_at=time.time() + 300  # 5分钟有效期
        )
        
        self._modify_count_hour += 1
        self._audit_log.append({
            "timestamp": time.time(),
            "permit": permit.permit_id,
            "target": target_module,
            "safety_score": safety_score
        })
        
        return permit
    
    def _scan_ast_safety(self, tree: ast.AST) -> float:
        """
        AST 安全扫描
        返回安全评分 0-1
        """
        score = 1.0
        dangerous_nodes = 0
        total_nodes = 0
        
        for node in ast.walk(tree):
            total_nodes += 1
            
            # 检查禁止的调用
            if isinstance(node, ast.Call):
                func_name = self._get_call_name(node)
                if func_name in ConstitutionalInvariants.CODE_SAFETY["forbidden_modules"]:
                    dangerous_nodes += 10  # 严重违规
            
            # 检查导入
            if isinstance(node, (ast.Import, ast.ImportFrom)):
                for alias in node.names:
                    if alias.name in ConstitutionalInvariants.CODE_SAFETY["forbidden_modules"]:
                        dangerous_nodes += 10
            
            # 检查动态执行
            if isinstance(node, (ast.Exec,)):
                dangerous_nodes += 100  # 绝对禁止
        
        if total_nodes == 0:
            return 1.0
        
        score = max(0.0, 1.0 - (dangerous_nodes / total_nodes))
        return score
    
    def _get_call_name(self, node: ast.Call) -> str:
        """获取调用名称"""
        if isinstance(node.func, ast.Name):
            return node.func.id
        elif isinstance(node.func, ast.Attribute):
            parts = []
            n = node.func
            while isinstance(n, ast.Attribute):
                parts.append(n.attr)
                n = n.value
            if isinstance(n, ast.Name):
                parts.append(n.id)
            return ".".join(reversed(parts))
        return ""
    
    def _calculate_max_scope(self, tree: ast.AST) -> int:
        """计算代码范围限制"""
        return len(ast.dump(tree).split("\n")) * 2  # 粗略估算
    
    def verify_execution_safety(self, code: str) -> bool:
        """运行时执行前最终验证"""
        try:
            tree = ast.parse(code)
            return self._scan_ast_safety(tree) >= 0.95
        except SyntaxError:
            return False


class ConstitutionalViolation(Exception):
    """宪法违规异常"""
    pass
