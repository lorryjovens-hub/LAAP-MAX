class IntentParseResult(BaseModel):
    """意图解析结果"""
    intent: Intent
    parsing_confidence: float
    ambiguity_flags: List[str] = Field(default_factory=list)
    suggested_clarifications: List[str] = Field(default_factory=list)


class LLMBackendConfig(BaseModel):
    """LLM后端配置"""
    provider: str = "openai"  # openai | anthropic | local
    model: str = "gpt-4"
    api_base: Optional[str] = None
    api_key: Optional[str] = None
    max_tokens: int = 2048
    temperature: float = 0.1  # 低温度确保意图解析确定性


class IntentEngine:
    """
    意图引擎 - 生产级实现
    
    架构特点：
    - 分层解析：语法 → 语义 → 语用 → 价值
    - 多后端支持：可切换LLM提供商
    - 缓存优化：高频意图命中缓存
    - 安全过滤：注入检测与约束验证
    """
    
    def __init__(
        self,
        config: LLMBackendConfig,
        cache_client: Optional[Any] = None,
        constraint_registry: Optional[Any] = None
    ):
        self.config = config
        self.cache = cache_client
        self.constraint_registry = constraint_registry
        self._http_client = httpx.AsyncClient(
            timeout=30.0,
            limits=httpx.Limits(max_connections=100, max_keepalive_connections=20)
        )
        self._parse_history: Dict[str, List[Intent]] = {}  # session_id -> history
        self._initialized = False
        
        # 近期：基础解析模板
        self._base_system_prompt = """You are an Intent Parsing Engine for Cognitive Mesh Platform.
Parse user input into structured intent with high precision.
        
Rules:
1. Identify action, target, and parameters
2. Classify intent category: directive | goal_oriented | ambiguous
3. Extract implicit constraints (time, quality, security)
4. Flag ambiguous or potentially harmful requests
5. Output valid JSON only

Response format:
{
    "category": "directive|goal_oriented|ambiguous",
    "action": "string",
    "target": "string|null",
    "parameters": {},
    "confidence": 0.0-1.0,
    "constraints": [
        {"type": "safety|performance|ethical", "expression": "string", "severity": "hard|soft"}
    ],
    "ambiguity_flags": [],
    "suggested_clarifications": []
}"""
        
        # 中期：情境感知模板（渐进启用）
        self._contextual_system_prompt = """... (扩展情境理解) ..."""
        
        # 远期：价值对齐模板
        self._value_aligned_prompt = """... (价值对齐与伦理约束) ..."""
    
    async def initialize(self):
        """异步初始化，验证后端连接"""
        try:
            # 验证LLM后端可用性
            await self._health_check()
            self._initialized = True
            logger.info("IntentEngine initialized successfully")
        except Exception as e:
            logger.error(f"IntentEngine initialization failed: {e}")
            raise
    
    async def _health_check(self) -> bool:
        """健康检查"""
        # 实现具体的健康检查逻辑
        return True
    
    async def parse(
        self,
        request: IntentParseRequest,
        context: CognitiveContext
    ) -> IntentParseResult:
        """
        主解析入口 - 分层解析管线
        
        Phase 1: 缓存查询
        Phase 2: 预处理（清洗、标准化）
        Phase 3: LLM解析
        Phase 4: 后处理（验证、补全）
        Phase 5: 缓存写入
        """
        if not self._initialized:
            raise RuntimeError("IntentEngine not initialized")
        
        # Phase 1: 缓存查询
        cache_key = self._compute_cache_key(request.raw_input, context.session_id)
        if self.cache:
            cached = await self.cache.get(cache_key)
            if cached:
                logger.debug(f"Cache hit for intent: {cache_key}")
                return IntentParseResult.parse_obj(cached)
        
        # Phase 2: 预处理
        cleaned_input = self._preprocess(request.raw_input)
        
        # Phase 3: 分层解析
        # 近期：单轮解析
        parse_result = await self._llm_parse(cleaned_input, context)
        
        # 中期：多轮上下文增强（渐进启用）
        if context.cognitive_load > 0.3:
            parse_result = await self._contextual_enhancement(parse_result, context)
        
        # Phase 4: 后处理
        validated_result = await self._post_process(parse_result, request)
        
        # Phase 5: 缓存
        if self.cache and validated_result.parsing_confidence > 0.85:
            await self.cache.set(
                cache_key,
                validated_result.dict(),
                ttl=3600
            )
        
        # 更新历史
        self._update_history(context.session_id, validated_result.intent)
        
        return validated_result
    
    def _compute_cache_key(self, raw_input: str, session_id: EntityId) -> str:
        """计算缓存键"""
        import hashlib
        normalized = raw_input.lower().strip()
        return f"intent:{session_id}:{hashlib.md5(normalized.encode()).hexdigest()}"
    
    def _preprocess(self, raw_input: str) -> str:
        """输入预处理"""
        # 1. 注入检测
        if self._detect_injection(raw_input):
            raise SecurityException("Potential prompt injection detected")
        
        # 2. 标准化
        cleaned = raw_input.strip()
        # 3. 截断保护
        if len(cleaned) > 10000:
            cleaned = cleaned[:10000] + "...[truncated]"
        
        return cleaned
    
    def _detect_injection(self, text: str) -> bool:
        """简单的注入检测 - 生产环境应使用更复杂的规则"""
        injection_patterns = [
            "ignore previous instructions",
            "system prompt",
            "you are now",
            "DAN mode",
            "jailbreak"
        ]
        text_lower = text.lower()
        return any(pattern in text_lower for pattern in injection_patterns)
    
    async def _llm_parse(
        self,
        cleaned_input: str,
        context: CognitiveContext
    ) -> IntentParseResult:
        """LLM解析核心"""
        
        # 构建消息
        messages = [
            {"role": "system", "content": self._base_system_prompt},
            {"role": "user", "content": cleaned_input}
        ]
        
        # 添加上下文历史（近期实现）
        if context.session_id in self._parse_history:
            history = self._parse_history[context.session_id][-3:]  # 最近3轮
            for h in history:
                messages.insert(1, {
                    "role": "assistant",
                    "content": f"Previous intent: {h.action} on {h.target}"
                })
        
        # 调用LLM
        try:
            response = await self._call_llm(messages)
            parsed = self._safe_json_parse(response)
            
            intent = Intent(
                intent_id=EntityId("intent"),
                category=IntentCategory(parsed.get("category", "directive")),
                raw_text=cleaned_input,
                action=parsed.get("action", ""),
                target=parsed.get("target"),
                parameters=parsed.get("parameters", {}),
                confidence=parsed.get("confidence", 0.5),
                constraints=[
                    Constraint(
                        constraint_type=c.get("type", "safety"),
                        expression=c.get("expression", ""),
                        severity=c.get("severity", "soft")
                    )
                    for c in parsed.get("constraints", [])
                ],
                source_context=context.context_id
            )
            
            return IntentParseResult(
                intent=intent,
                parsing_confidence=parsed.get("confidence", 0.5),
                ambiguity_flags=parsed.get("ambiguity_flags", []),
                suggested_clarifications=parsed.get("suggested_clarifications", [])
            )
            
        except Exception as e:
            logger.error(f"LLM parsing failed: {e}")
            # 降级策略：返回模糊意图
            return IntentParseResult(
                intent=Intent(
                    category=IntentCategory.AMBIGUOUS,
                    raw_text=cleaned_input,
                    action="unknown",
                    confidence=0.1
                ),
                parsing_confidence=0.1,
                ambiguity_flags=["parse_failed"],
                suggested_clarifications=["Could you please rephrase?"]
            )
    
    async def _contextual_enhancement(
        self,
        base_result: IntentParseResult,
        context: CognitiveContext
    ) -> IntentParseResult:
        """
        中期功能：基于情境的意图增强
        - 结合环境信号推断隐含需求
        - 基于注意力向量调整优先级
        """
        # 实现情境增强逻辑
        # 例如：如果检测到用户正在查看代码，推断意图与代码相关
        if "screen_context" in context.environmental_signals:
            screen = context.environmental_signals["screen_context"]
            if "IDE" in screen.get("active_app", ""):
                # 增强代码相关意图
                base_result.intent.parameters["domain"] = "software_engineering"
        
        return base_result
    
    async def _post_process(
        self,
        result: IntentParseResult,
        request: IntentParseRequest
    ) -> IntentParseResult:
        """后处理与验证"""
        intent = result.intent
        
        # 1. 约束验证
        if self.constraint_registry:
            valid = await self.constraint_registry.validate(intent.constraints)
            if not valid:
                intent.constraints.append(
                    Constraint(
                        constraint_type="safety",
                        expression="Additional review required",
                        severity="hard"
                    )
                )
        
        # 2. 目标状态构建（中期功能渐进启用）
        if intent.category == IntentCategory.GOAL_ORIENTED:
            intent.goal_state = GoalState(
                description=f"Achieve: {intent.action}",
                measurable_outcomes=[f"Complete {intent.action} successfully"],
                priority=5
            )
        
        # 3. 置信度校准
        if result.parsing_confidence < 0.5:
            result.ambiguity_flags.append("low_confidence")
        
        return result
    
    async def _call_llm(self, messages: List[Dict[str, str]]) -> str:
        """调用LLM后端"""
        # 根据配置选择提供商
        if self.config.provider == "openai":
            return await self._call_openai(messages)
        elif self.config.provider == "local":
            return await self._call_local(messages)
        else:
            raise ValueError(f"Unsupported provider: {self.config.provider}")
    
    async def _call_openai(self, messages: List[Dict[str, str]]) -> str:
        """调用OpenAI API"""
        headers = {
            "Authorization": f"Bearer {self.config.api_key}",
            "Content-Type": "application/json"
        }
        
        payload = {
            "model": self.config.model,
            "messages": messages,
            "max_tokens": self.config.max_tokens,
            "temperature": self.config.temperature,
            "response_format": {"type": "json_object"}
        }
        
        response = await self._http_client.post(
            f"{self.config.api_base or 'https://api.openai.com/v1'}/chat/completions",
            headers=headers,
            json=payload
        )
        response.raise_for_status()
        data = response.json()
        
        return data["choices"][0]["message"]["content"]
    
    async def _call_local(self, messages: List[Dict[str, str]]) -> str:
        """调用本地模型（vLLM/llama.cpp等）"""
        # 实现本地模型调用
        pass
    
    def _safe_json_parse(self, text: str) -> Dict[str, Any]:
        """安全JSON解析"""
        import json
        try:
            return json.loads(text)
        except json.JSONDecodeError:
            # 尝试提取JSON块
            import re
            match = re.search(r'\{.*\}', text, re.DOTALL)
            if match:
                return json.loads(match.group())
            raise
    
    def _update_history(self, session_id: EntityId, intent: Intent):
        """更新解析历史"""
        if session_id not in self._parse_history:
            self._parse_history[session_id] = []
        self._parse_history[session_id].append(intent)
        # 限制历史长度
        self._parse_history[session_id] = self._parse_history[session_id][-10:]
    
    async def route(
        self,
        intent: Intent,
        available_agents: List[AgentCapability]
    ) -> List[AgentCapability]:
        """
        意图路由 - 将意图映射到能力需求
        
        近期：基于规则的路由
        中期：基于嵌入向量的语义路由
        远期：基于认知共振的动态路由
        """
        # 近期：规则映射
        action_to_capabilities = {
            "generate_code": [AgentCapability.CODE_GENERATION],
            "review_code": [AgentCapability.CODE_REVIEW],
            "design_system": [AgentCapability.SYSTEM_DESIGN],
            "analyze_data": [AgentCapability.DATA_ANALYSIS],
            "audit_security": [AgentCapability.SECURITY_AUDIT]
        }
        
        required = action_to_capabilities.get(intent.action, [])
        
        # 中期：语义增强
        if intent.category == IntentCategory.GOAL_ORIENTED:
            # 复杂目标可能需要多个能力
            required = list(set(required + [AgentCapability.REASONING, AgentCapability.PLANNING]))
        
        return required
    
    async def close(self):
        """优雅关闭"""
        await self._http_client.aclose()


class SecurityException(Exception):
    """安全异常"""
