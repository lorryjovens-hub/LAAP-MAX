```python
# src/hermes/rsi/evolutionary_loop.py
"""
Evolutionary Loop — 进化循环
基于适应度函数的递归自我改进循环。
"""

import asyncio
import logging
import random
from dataclasses import dataclass
from datetime import datetime
from typing import Any, Callable, Dict, List, Optional

from src.hermes.rsi.constitutional import ConstitutionalGuard, ModificationPermit
from src.hermes.rsi.self_modification import Mutation, SelfModificationEngine
from src.hermes.rsi.self_model import IntrospectionEngine

logger = logging.getLogger("hermes.rsi.evolution")


@dataclass
class FitnessScore:
    """适应度评分"""
    overall: float = 0.0  # 0-1
    performance: float = 0.0
    reliability: float = 0.0
    maintainability: float = 0.0
    capability_coverage: float = 0.0
    timestamp: datetime = field(default_factory=datetime.utcnow)


class EvolutionaryLoop:
    """
    进化循环 — RSI 的引擎
    
    循环：
    1. 内省（Introspect）— 建立自我模型
    2. 评估（Evaluate）— 计算当前适应度
    3. 选择（Select）— 选择改进目标
    4. 变异（Mutate）— 生成修改方案
    5. 验证（Validate）— 宪法检查 + 测试
    6. 应用（Apply）— 热重载
    7. 观察（Observe）— 收集性能反馈
    8. 学习（Learn）— 更新策略
    
    重复直到收敛或人类干预。
    """
    
    def __init__(
        self,
        introspection: IntrospectionEngine,
        modification: SelfModificationEngine,
        guard: ConstitutionalGuard,
        fitness_fn: Optional[Callable] = None
    ):
        self.introspection = introspection
        self.modification = modification
        self.guard = guard
        self.fitness_fn = fitness_fn or self._default_fitness
        
        # 进化状态
        self.generation = 0
        self.current_fitness = FitnessScore()
        self.fitness_history: List[FitnessScore] = []
        self._evolution_task: Optional[asyncio.Task] = None
        self._shutdown = asyncio.Event()
        
        # 策略参数（可自我调整）
        self.mutation_rate = 0.1
        self.selection_pressure = 1.5
        self.exploration_ratio = 0.2
    
    async def start(self):
        """启动进化循环"""
        logger.info("RSI Evolutionary Loop starting...")
        self._evolution_task = asyncio.create_task(self._loop())
    
    async def _loop(self):
        """主循环"""
        while not self._shutdown.is_set():
            try:
                await self._evolve_step()
                await asyncio.wait_for(self._shutdown.wait(), timeout=60)
            except asyncio.TimeoutError:
                continue
            except Exception as e:
                logger.error(f"Evolution step failed: {e}")
                await asyncio.sleep(300)  # 失败后冷却
    
    async def _evolve_step(self):
        """单步进化"""
        self.generation += 1
        logger.info(f"=== Evolution Generation {self.generation} ===")
        
        # 1. 内省
        await self.introspection.build_self_model()
        self_model = self.introspection.self_model
        
        # 2. 评估
        fitness = await self._evaluate_fitness()
        self.current_fitness = fitness
        self.fitness_history.append(fitness)
        
        logger.info(f"Current fitness: {fitness.overall:.3f}")
        
        # 检查是否收敛
        if self._is_converged():
            logger.info("Evolution converged. Entering dormancy.")
            await asyncio.sleep(3600)  # 休眠1小时
            return
        
        # 3. 选择改进目标
        candidates = self.introspection.get_improvement_candidates(limit=3)
        if not candidates:
            logger.info("No improvement candidates found.")
            return
        
        # 4. 尝试变异
        for candidate in candidates:
            success = await self._attempt_mutation(candidate)
            if success:
                break  # 一代只应用一个成功突变
        
        # 5. 调整策略（元学习）
        self._adapt_strategy()
    
    async def _evaluate_fitness(self) -> FitnessScore:
        """
        计算适应度
        
        多目标优化：
        - 性能（响应时间、吞吐量）
        - 可靠性（错误率、成功率）
        - 可维护性（复杂度、文档覆盖率）
        - 能力覆盖（功能完整性）
        """
        model = self.introspection.self_model
        
        # 性能（基于代码复杂度代理）
        avg_complexity = sum(n.complexity for n in model.code_nodes.values() if n.node_type == "function")
        avg_complexity /= max(len([n for n in model.code_nodes.values() if n.node_type == "function"]), 1)
        performance = max(0, 1.0 - (avg_complexity / 20))
        
        # 可靠性（基于已知问题）
        reliability = max(0, 1.0 - (len(model.known_issues) / 100))
        
        # 可维护性
        documented = sum(1 for n in model.code_nodes.values() if '"""' in n.source_code)
        total = len(model.code_nodes)
        maintainability = documented / max(total, 1)
        
        # 能力覆盖
        capability_coverage = len(model.capabilities) / 20  # 假设20个目标能力
        
        overall = (
            performance * 0.3 +
            reliability * 0.3 +
            maintainability * 0.2 +
            capability_coverage * 0.2
        )
        
        return FitnessScore(
            overall=overall,
            performance=performance,
            reliability=reliability,
            maintainability=maintainability,
            capability_coverage=capability_coverage
        )
    
    async def _attempt_mutation(self, candidate: Dict) -> bool:
        """尝试应用突变"""
        target = candidate["target"]
        strategy = candidate["strategy"]
        
        logger.info(f"Attempting mutation: {strategy} on {target}")
        
        # 生成突变
        mutations = await self.modification.propose_modification(
            target_node_id=target,
            improvement_goal=candidate.get("expected_impact", "improve"),
            strategy=strategy
        )
        
        if not mutations:
            return False
        
        for mutation in mutations:
            # 获取宪法许可
            try:
                node = self.introspection.self_model.code_nodes[target]
                permit = self.guard.check_modification(
                    target_module=node.module_name,
                    proposed_ast=mutation.modified_ast,
                    context={"mutation_type": mutation.mutation_type}
                )
            except ConstitutionalViolation as e:
                logger.warning(f"Constitutional check failed: {e}")
                continue
            
            # 验证
            valid = await self.modification.validate_mutation(mutation, permit)
            if not valid:
                logger.warning(f"Mutation validation failed: {mutation.mutation_id}")
                continue
            
            # 应用
            try:
                success = await self.modification.apply_mutation(mutation, permit)
                if success:
                    logger.info(f"Mutation applied: {mutation.mutation_id}")
                    return True
            except Exception as e:
                logger.error(f"Mutation application failed: {e}")
                await self.modification.rollback()
        
        return False
    
    def _is_converged(self) -> bool:
        """检查是否收敛"""
        if len(self.fitness_history) < 5:
            return False
        
        # 最近5代适应度变化 < 1%
        recent = [f.overall for f in self.fitness_history[-5:]]
        return max(recent) - min(recent) < 0.01
    
    def _adapt_strategy(self):
        """
        元学习：调整进化策略
        
        如果最近成功率低，降低变异率，增加探索。
        如果适应度提升快，增加选择压力。
        """
        if len(self.modification.mutation_history) < 3:
            return
        
        recent_success = sum(
            1 for m in self.modification.mutation_history[-3:]
            if m.tests_passed
        ) / 3
        
        if recent_success < 0.5:
            self.mutation_rate *= 0.9  # 更保守
            self.exploration_ratio = min(0.5, self.exploration_ratio * 1.1)
        else:
            self.mutation_rate = min(0.3, self.mutation_rate * 1.1)
            self.exploration_ratio *= 0.9
        
        logger.debug(f"Strategy adapted: mutation_rate={self.mutation_rate:.3f}, exploration={self.exploration_ratio:.3f}")
    
    async def get_status(self) -> Dict[str, Any]:
        """获取进化状态"""
        return {
            "generation": self.generation,
            "fitness": {
                "current": self.current_fitness.overall,
                "history": [f.overall for f in self.fitness_history[-10:]]
            },
            "mutations_applied": len(self.modification.mutation_history),
            "strategy": {
                "mutation_rate": self.mutation_rate,
                "exploration_ratio": self.exploration_ratio
            }
        }
    
    async def stop(self):
        """停止进化"""
        self._shutdown.set()
        if self._evolution_task:
            self._evolution_task.cancel()
        logger.info("Evolutionary loop stopped")
