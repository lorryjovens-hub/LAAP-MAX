        """目标分解"""
        # 使用推理引擎分解复杂目标
        if intent.goal_state:
            # 基于目标状态分解
            reasoning = await self.reasoning.reason(
                CognitiveContext(raw_input=intent.raw_text),
                f"Decompose goal: {intent.goal_state.description}"
            )
            # 解析分解结果
            return self._parse_decomposition(reasoning.conclusion)
        
        # 简单动作直接映射
        return [{"action": intent.action, "parameters": intent.parameters}]
    
    def _parse_decomposition(self, reasoning_text: str) -> List[Dict]:
        """解析分解结果"""
        # 实现解析逻辑
        return [{"action": "default", "parameters": {}}]
    
    def _infer_capabilities(self, subgoal: Dict) -> List[AgentCapability]:
        """推断所需能力"""
        action = subgoal.get("action", "")
        mapping = {
            "generate_code": [AgentCapability.CODE_GENERATION],
            "analyze": [AgentCapability.DATA_ANALYSIS],
            "design": [AgentCapability.SYSTEM_DESIGN],
            "verify": [AgentCapability.SECURITY_AUDIT]
        }
        return mapping.get(action, [])
    
    def _infer_timeout(self, subgoal: Dict) -> int:
        """推断超时时间"""
        # 基于动作复杂度
        complexity = subgoal.get("complexity", "medium")
        return {"low": 10, "medium": 30, "high": 120}.get(complexity, 30)
    
    def _enforce_constraint(self, steps: List[PlanStep], constraint: Constraint):
        """强制执行硬约束"""
        if constraint.constraint_type == "safety":
            # 添加安全检查步骤
            steps.insert(0, PlanStep(
                step_id=-1,
                action_type="safety_check",
                input_payload={"constraint": constraint.expression}
            ))
    
    def _generate_rollback(self, steps: List[PlanStep]) -> str:
        """生成回滚策略"""
        # 为每个步骤生成补偿操作
        compensations = []
        for step in reversed(steps):
            compensations.append(f"undo_{step.action_type}")
        return " -> ".join(compensations)
    
    def _estimate_resources(self, steps: List[PlanStep]) -> Dict[str, Any]:
        """估算资源需求"""
        return {
            "estimated_cpu_ms": len(steps) * 1000,
            "estimated_memory_mb": len(steps) * 50,
            "external_calls": sum(1 for s in steps if s.action_type.startswith("api_"))
        }
    
    async def replan(
        self,
        current_plan: ExecutionPlan,
        failed_step: int,
        failure_reason: str
    ) -> ExecutionPlan:
        """
        中期功能：动态重规划
        
        当某步骤失败时，基于当前状态重新规划剩余步骤
        """
        # 保留成功步骤
        successful_steps = current_plan.steps[:failed_step]
        
        # 重新规划剩余部分
        remaining_intent = Intent(
            action="recover_and_continue",
            parameters={
                "original_plan": current_plan.plan_id,
                "failure": failure_reason,
                "completed_steps": [s.step_id for s in successful_steps]
            }
        )
        
        # 生成新计划
        new_plan = await self.plan(
            remaining_intent,
            [],  # 继承原约束
            []   # 重新发现Agent
        )
        
        # 合并
        combined_steps = successful_steps + [
            PlanStep(
                step_id=s.step_id + len(successful_steps),
                **{k: v for k, v in vars(s).items() if k != "step_id"}
            )
            for s in new_plan.steps
        ]
        
        return ExecutionPlan(
            plan_id=EntityId("plan"),
            intent_id=current_plan.intent_id,
            steps=combined_steps,
            rollback_strategy=current_plan.rollback_strategy
        )


