from src.hermes.rsi.self_model import CodeNode, IntrospectionEngine, SelfModel

logger = logging.getLogger("hermes.rsi.self_modification")


@dataclass
class Mutation:
    """突变 — 代码变更的抽象表示"""
    mutation_id: str
    target_node_id: str
    mutation_type: str  # "refactor", "optimize", "extend", "repair"
    
    # 变更前后
    original_ast: ast.AST
    modified_ast: ast.AST
    original_source: str
    modified_source: str
    
