                "parameters": self.parameters
            }
        }
    
    def to_anthropic_tool(self) -> Dict[str, Any]:
        return {
            "name": self.name,
            "description": self.description,
            "input_schema": self.parameters
        }

@dataclass
class ToolCall:
    """工具调用请求"""
    call_id: str = field(default_factory=lambda: f"call_{uuid.uuid4().hex[:12]}")
    tool_name: str = ""
    arguments: Dict[str, Any] = field(default_factory=dict)
    caller_id: Optional[LifeID] = None
    timeout_ms: int = 30000
    trace_id: str = ""
    
    @property
    def fingerprint(self) -> str:
        """调用指纹，用于缓存和去重"""
        data = json.dumps({
            "tool": self.tool_name,
            "args": self._normalize_args(self.arguments)
        }, sort_keys=True)
        return hashlib.sha256(data.encode()).hexdigest()[:16]
    
    def _normalize_args(self, args: Any) -> Any:
        if isinstance(args, dict):
            return {k: self._normalize_args(v) for k, v in sorted(args.items())}
        if isinstance(args, list):
            return [self._normalize_args(v) for v in args]
        return args

@dataclass
class ToolResult:
    """工具调用结果"""
    call_id: str = ""
    tool_name: str = ""
    status: Literal["success", "error", "timeout", "rejected"] = "success"
    output: Any = None
    error_message: Optional[str] = None
    execution_time_ms: int = 0
    resource_usage: Dict[str, float] = field(default_factory=dict)
    artifacts: List[Artifact] = field(default_factory=list)
