        key = str(agent_id)
        current = self._trust_scores.get(key, 0.5)
        
        # 贝叶斯更新
        if task_result:
            # 成功：向1.0靠近
            alpha = 0.1
            new_trust = current + alpha * (1.0 - current)
        else:
            # 失败：向0.0靠近
            beta = 0.2
            new_trust = current - beta * current
        
        # 外部反馈加权
        if feedback_score is not None:
            new_trust = 0.7 * new_trust + 0.3 * feedback_score
        
        self._trust_scores[key] = max(0.0, min(1.0, new_trust))
        logger.debug(f"Trust updated for {key}: {current:.3f} -> {new_trust:.3f}")
    
