## 三、上下文编织器（Context Weaver）

解决大模型上下文限制，实现**无限上下文**的幻觉。

```python
# src/hermes/cal/context_weave.py
"""
Context Weaver — 上下文编织器
通过分层记忆和动态检索，突破模型的上下文长度限制。
核心思想：模型不需要记住所有内容，只需要在需要时精确检索。
"""

import asyncio
import hashlib
import logging
from dataclasses import dataclass, field
from datetime import datetime, timedelta
from typing import Any, Dict, List, Optional, Set, Tuple

import numpy as np
from qdrant_client import QdrantClient
from qdrant_client.models import Distance, PointStruct, VectorParams

logger = logging.getLogger("hermes.cal.context_weave")


@dataclass
class MemoryChunk:
    """记忆片段 — 上下文的最小单元"""
    chunk_id: str
    content: str
    memory_type: str  # "working", "episodic", "semantic", "procedural"
    embedding: Optional[List[float]] = None
    importance: float = 0.5  # 0-1
    access_count: int = 0
    last_accessed: datetime = field(default_factory=datetime.utcnow)
    created_at: datetime = field(default_factory=datetime.utcnow)
    tags: Set[str] = field(default_factory=set)
    source: Optional[str] = None  # 来源文件/模块
    token_count: int = 0
    
    def touch(self):
        """访问时更新"""
        self.access_count += 1
        self.last_accessed = datetime.utcnow()
        # 重要性随访问增加
        self.importance = min(1.0, self.importance + 0.05)


class HierarchicalMemory:
    """
    分层记忆系统
    
    L1: 工作记忆 (Working Memory) — 4k tokens，当前会话
    L2: 情节记忆 (Episodic Memory) — 最近 N 次交互，向量检索
    L3: 语义记忆 (Semantic Memory) — 知识概念，长期存储
    L4: 程序记忆 (Procedural Memory) — 代码模式、工具使用经验
    
    模型只加载 L1（极省 token），L2-L4 按需检索注入。
    """
    
    def __init__(
        self,
        embedding_dim: int = 768,
        qdrant_host: str = "localhost",
        qdrant_port: int = 6333
    ):
        self.embedding_dim = embedding_dim
        self.client = QdrantClient(host=qdrant_host, port=qdrant_port)
        
        # L1: 工作记忆（内存，极快）
        self.working_memory: List[MemoryChunk] = []
        self.working_memory_limit = 10  # 最多 10 个 chunk
        
        # L2-L4: 长期记忆（向量数据库）
        self.collections = {
            "episodic": "memory_episodic",
            "semantic": "memory_semantic",
            "procedural": "memory_procedural"
        }
        
        # 注意力缓存
        self._attention_weights: Dict[str, float] = {}
        
        # 初始化集合
        self._initialized = False
    
    async def initialize(self):
        """初始化向量存储"""
        if self._initialized:
            return
        
        for name in self.collections.values():
            try:
                self.client.create_collection(
                    collection_name=name,
                    vectors_config=VectorParams(
                        size=self.embedding_dim,
                        distance=Distance.COSINE
                    )
                )
            except Exception as e:
                if "already exists" not in str(e).lower():
                    raise
        
        self._initialized = True
    
    async def add_to_working_memory(self, chunk: MemoryChunk):
        """添加到工作记忆"""
        self.working_memory.append(chunk)
        
        # 溢出时：将最老的/最不重要的写入长期记忆
        while len(self.working_memory) > self.working_memory_limit:
            evicted = self._select_for_eviction()
            if evicted:
                await self._consolidate_to_long_term(evicted)
                self.working_memory.remove(evicted)
    
    def _select_for_eviction(self) -> Optional[MemoryChunk]:
        """选择要驱逐的 chunk（LRU + 重要性）"""
        if not self.working_memory:
            return None
        
        # 计算综合分数：低重要性 + 老访问时间 = 优先驱逐
        def score(chunk: MemoryChunk) -> float:
            age = (datetime.utcnow() - chunk.last_accessed).total_seconds()
            return chunk.importance * 1000 - age
        
        return min(self.working_memory, key=score)
    
    async def _consolidate_to_long_term(self, chunk: MemoryChunk):
        """巩固到长期记忆"""
        if not chunk.embedding:
            chunk.embedding = await self._embed(chunk.content)
        
        # 根据内容类型选择集合
        collection = self.collections.get(chunk.memory_type, "memory_episodic")
        
        point = PointStruct(
            id=chunk.chunk_id,
            vector=chunk.embedding,
            payload={
                "content": chunk.content,
                "importance": chunk.importance,
                "tags": list(chunk.tags),
                "source": chunk.source,
                "created_at": chunk.created_at.isoformat()
            }
        )
        
        self.client.upsert(collection_name=collection, points=[point])
    
    async def retrieve(
        self,
        query: str,
        query_embedding: Optional[List[float]] = None,
        top_k: int = 5,
        memory_types: Optional[List[str]] = None,
        recency_weight: float = 0.3,
        context_window: int = 4000
    ) -> List[MemoryChunk]:
        """
        检索相关记忆
        
        这是核心：根据当前 query，从海量记忆中精准捞出最相关的 5 个 chunk。
        相比把 100k 上下文全塞给模型，只塞 5 个相关 chunk，省 95% token。
        """
        if query_embedding is None:
            query_embedding = await self._embed(query)
        
        # 1. 工作记忆检索（O(1)，超快）
        working_results = self._search_working_memory(query, query_embedding)
        
        # 2. 长期记忆检索（向量搜索）
        long_term_results = []
        types = memory_types or list(self.collections.keys())
        
        for mem_type in types:
            collection = self.collections.get(mem_type, f"memory_{mem_type}")
            try:
                results = self.client.search(
                    collection_name=collection,
                    query_vector=query_embedding,
                    limit=top_k,
                    with_payload=True
                )
                
                for res in results:
                    payload = res.payload or {}
                    chunk = MemoryChunk(
                        chunk_id=str(res.id),
                        content=payload.get("content", ""),
                        memory_type=mem_type,
                        embedding=res.vector,
                        importance=payload.get("importance", 0.5),
                        tags=set(payload.get("tags", [])),
                        source=payload.get("source"),
                        last_accessed=datetime.fromisoformat(payload.get("last_accessed", datetime.utcnow().isoformat()))
                    )
                    
                    # 重排序：相似度 + 重要性 + 时间衰减
                    age_hours = (datetime.utcnow() - chunk.last_accessed).total_seconds() / 3600
                    recency = np.exp(-recency_weight * age_hours / 24)
                    
                    chunk._score = res.score * 0.5 + chunk.importance * 0.3 + recency * 0.2
                    long_term_results.append(chunk)
                    
            except Exception as e:
                logger.error(f"Vector search failed for {collection}: {e}")
        
        # 3. 合并与重排序
        all_results = working_results + long_term_results
        all_results.sort(key=lambda x: getattr(x, '_score', 0), reverse=True)
        
        # 4. 上下文预算管理：只返回能塞进 context_window 的 chunk
        selected = []
        current_tokens = 0
        
        for chunk in all_results:
            if current_tokens + chunk.token_count > context_window:
                break
            selected.append(chunk)
            chunk.touch()  # 访问标记
            current_tokens += chunk.token_count
        
        return selected
    
    def _search_working_memory(self, query: str, query_embedding: List[float]) -> List[MemoryChunk]:
        """在工作记忆中搜索（简单文本匹配 + 向量）"""
        results = []
        query_lower = query.lower()
        
        for chunk in self.working_memory:
            # 文本匹配
            text_score = 0.0
            if query_lower in chunk.content.lower():
                text_score = 1.0
            
            # 向量相似度（如果都有 embedding）
            vector_score = 0.0
            if chunk.embedding and query_embedding:
                vector_score = self._cosine_sim(chunk.embedding, query_embedding)
            
            chunk._score = text_score * 0.7 + vector_score * 0.3
            results.append(chunk)
        
        return sorted(results, key=lambda x: x._score, reverse=True)[:5]
    
    def _cosine_sim(self, a: List[float], b: List[float]) -> float:
        """余弦相似度"""
        a_np = np.array(a)
        b_np = np.array(b)
        return float(np.dot(a_np, b_np) / (np.linalg.norm(a_np) * np.linalg.norm(b_np)))
    
    async def _embed(self, text: str) -> List[float]:
        """生成嵌入（使用本地轻量模型）"""
        # 生产环境：使用 sentence-transformers 或 ONNX 模型
        # 这里使用简化实现
        import random
        return [random.random() for _ in range(self.embedding_dim)]


class ContextWeaver:
    """
    上下文编织器 — 将分散的记忆编织成连贯的模型输入
    
    核心能力：
    1. 动态上下文组装：根据当前任务，实时选择最相关的记忆
    2. 冗余消除：避免重复信息
    3. 连贯性注入：在 chunk 之间添加过渡，帮助模型理解关系
    4. 摘要压缩：对过长历史进行渐进式摘要
    """
    
    def __init__(self, memory: HierarchicalMemory):
        self.memory = memory
        self._compression_ratio = 0.3  # 摘要压缩到 30%
    
    async def weave(
        self,
        current_query: str,
        system_prompt: str = "",
        max_context_tokens: int = 6000,
        model_token_limit: int = 8192
    ) -> str:
        """
        编织上下文
        
        输出格式：
        [系统指令]
        [相关记忆 1]
        [相关记忆 2]
        ...
        [当前任务]
        
        总 token 严格控制在 max_context_tokens 内
        """
        # 1. 为 query 生成 embedding
        query_embedding = await self.memory._embed(current_query)
        
        # 2. 检索相关记忆
        relevant = await self.memory.retrieve(
            query=current_query,
            query_embedding=query_embedding,
            top_k=10,
            context_window=max_context_tokens - 500  # 预留 500 给系统指令和 query
        )
        
        # 3. 去重与合并
        merged = self._deduplicate(relevant)
        
        # 4. 按时间/逻辑排序
        ordered = self._reorder_chunks(merged, current_query)
        
        # 5. 生成连贯文本
        sections = []
        
        if system_prompt:
            sections.append(f"[SYSTEM]\n{system_prompt}\n")
        
        if ordered:
            sections.append("[RELEVANT CONTEXT]")
            for i, chunk in enumerate(ordered):
                sections.append(f"## Context {i+1} [{chunk.memory_type}]\n{chunk.content}\n")
        
        sections.append(f"[CURRENT TASK]\n{current_query}")
        
        return "\n".join(sections)
    
    def _deduplicate(self, chunks: List[MemoryChunk]) -> List[MemoryChunk]:
        """基于内容哈希去重"""
        seen = set()
        result = []
        
        for chunk in chunks:
            content_hash = hashlib.md5(chunk.content.encode()).hexdigest()[:16]
            if content_hash not in seen:
                seen.add(content_hash)
                result.append(chunk)
        
        return result
    
    def _reorder_chunks(self, chunks: List[MemoryChunk], query: str) -> List[MemoryChunk]:
        """重排序 chunk：时间顺序 + 逻辑依赖"""
        # 简单实现：按创建时间排序
        return sorted(chunks, key=lambda x: x.created_at)
    
    async def summarize_history(
        self,
        chunks: List[MemoryChunk],
        target_length: int = 500
    ) -> MemoryChunk:
        """
        渐进式摘要
        
        当历史太长时，将多个 chunk 压缩为一个摘要 chunk。
        这是实现"无限上下文"的关键：旧记忆被不断摘要，新记忆保持详细。
        """
        # 合并内容
        combined = "\n".join([c.content for c in chunks])
        
        # 生产环境：使用模型进行摘要
        # 这里使用简单启发式
        lines = combined.split("\n")
        if len(lines) > target_length // 10:
            # 保留关键行（包含错误、结果、决策的行）
            key_lines = [l for l in lines if any(k in l.lower() for k in ["error", "result", "decision", "conclusion", "final"])]
            summary = "\n".join(key_lines[:target_length // 10])
        else:
            summary = combined
        
        return MemoryChunk(
            chunk_id=f"summary_{hashlib.md5(summary.encode()).hexdigest()[:8]}",
            content=f"[SUMMARY] {summary}",
            memory_type="semantic",
            importance=max(c.importance for c in chunks),
            token_count=len(summary.split())
        )
