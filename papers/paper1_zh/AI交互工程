class CodeExecutionTool(ToolDriver):
    """
    代码执行工具 - 在隔离环境中运行 Python 代码
    安全级别：高（完全沙箱）
    """
    
    def __init__(self, timeout: int = 30):
        self._timeout = timeout
        self._schema = ToolSchema(
            name="execute_python",
            description="Execute Python code in a sandboxed environment",
            parameters={
                "type": "object",
                "properties": {
                    "code": {"type": "string", "description": "Python code to execute"},
                    "dependencies": {
                        "type": "array",
                        "items": {"type": "string"},
                        "description": "Required pip packages"
                    },
                    "timeout_seconds": {"type": "integer", "default": 30}
                },
                "required": ["code"]
            },
            returns={
                "type": "object",
                "properties": {
                    "stdout": {"type": "string"},
                    "stderr": {"type": "string"},
                    "return_value": {"type": "string"}
                }
            },
            side_effects=["exec", "file"],
            idempotent=False,
            timeout_seconds=timeout
        )
    
    @property
    def schema(self) -> ToolSchema:
        return self._schema
    
    async def execute(self, call: ToolCall, ctx: ExecutionContext) -> ToolResult:
        code = call.arguments["code"]
        timeout = call.arguments.get("timeout_seconds", self._timeout)
        
        # 安全检查
        dangerous = ["__import__", "eval(", "exec(", "os.system", "subprocess"]
        for d in dangerous:
            if d in code:
                return ToolResult(
                    call_id=call.call_id,
                    tool_name=self._schema.name,
                    status="rejected",
                    error_message=f"Forbidden pattern detected: {d}"
                )
        
        try:
            # 创建临时文件
            with tempfile.NamedTemporaryFile(mode='w', suffix='.py', delete=False) as f:
                f.write(code)
                temp_path = f.name
            
            # 使用受限子进程执行
            proc = await asyncio.create_subprocess_exec(
                "python", temp_path,
                stdout=asyncio.subprocess.PIPE,
                stderr=asyncio.subprocess.PIPE,
                limit=1024 * 1024  # 1MB 输出限制
            )
            
            stdout, stderr = await asyncio.wait_for(
                proc.communicate(),
                timeout=timeout
            )
            
            import os
            os.unlink(temp_path)
            
            return ToolResult(
                call_id=call.call_id,
                tool_name=self._schema.name,
                status="success" if proc.returncode == 0 else "error",
                output={
                    "stdout": stdout.decode('utf-8', errors='replace'),
                    "stderr": stderr.decode('utf-8', errors='replace'),
                    "returncode": proc.returncode
                }
            )
            
        except asyncio.TimeoutError:
            return ToolResult(
                call_id=call.call_id,
                tool_name=self._schema.name,
                status="timeout",
                error_message=f"Execution exceeded {timeout} seconds"
            )
        except Exception as e:
            return ToolResult(
                call_id=call.call_id,
                tool_name=self._schema.name,
                status="error",
                error_message=str(e)
            )
    
    async def health_check(self) -> VitalSigns:
        return VitalSigns(health_score=1.0)
    
    async def shutdown(self):
        pass


