    def __init__(
        self,
        profile: AgentProfile,
        harness: HermesHarness,
        llm_client: Optional[Any] = None
    ):
        self._profile = profile
        self._harness = harness
        self._llm = llm_client
        
        # 运行时状态
        self._state = LifeState.GESTATION
        self._task_queue: asyncio.Queue[Task] = asyncio.Queue()
        self._running_tasks: Dict[str, asyncio.Task] = {}
        self._tools: Dict[str, ToolDriver] = {}
        
        # 生命维持
        self._heartbeat_interval = 10.0
        self._heartbeat_task: Optional[asyncio.Task] = None
        self._main_loop_task: Optional[asyncio.Task] = None
        self._shutdown_event = asyncio.Event()
        
        # 记忆（简化）
        self._short_term_memory: List[Dict] = []
        self._max_memory_size = 1000
        
        # 自愈
        self._consecutive_errors = 0
        self._max_consecutive_errors = 10
    
    @property
    def profile(self) -> AgentProfile:
        return self._profile
    
    async def spawn(self, config: Dict[str, Any]) -> None:
        """孵化 Agent"""
        logger.info(f"Spawning agent {self._profile.name}")
        
        # 应用配置
        self._profile.autonomy_level = config.get("autonomy_level", 0.0)
        self._profile.max_concurrent_tasks = config.get("max_concurrent_tasks", 5)
        
        # 启动生命维持系统
        self._state = LifeState.ALIVE
        self._heartbeat_task = asyncio.create_task(self._heartbeat_loop())
        self._main_loop_task = asyncio.create_task(self._main_loop())
        
        # 注册到 harness 事件流
        self._harness.subscribe_events(self._on_harness_event)
        
        logger.info(f"Agent {self._profile.name} is ALIVE")
    
    async def bind_tool(self, tool: ToolDriver) -> None:
        """绑定工具"""
        self._tools[tool.schema.name] = tool
        await self._harness.registry.register(tool)
        logger.debug(f"Agent {self._profile.name} bound tool {tool.schema.name}")
    
    async def execute_task(self, task: Task) -> Task:
        """
        执行任务 - 核心工作循环
        
        1. 任务分解（如果需要）
        2. 工具选择
        3. 参数生成
        4. 工具调用
        5. 结果整合
        6. 记忆存储
        """
        task.assigned_agent = self._profile.agent_id
        task.status = "running"
        
        try:
            # 根据自主性级别决定执行策略
            if self._profile.autonomy_level < 0.3:
                # 低自主性：严格按指令执行
                result = await self._execute_directive(task)
            elif self._profile.autonomy_level < 0.7:
                # 中等自主性：可分解和规划
                result = await self._execute_planned(task)
            else:
                # 高自主性：自主决策
                result = await self._execute_autonomous(task)
            
            task.status = "completed"
            self._consecutive_errors = 0
            
        except Exception as e:
            logger.error(f"Task execution failed: {e}")
            task.status = "failed"
            self._consecutive_errors += 1
            
            # 自愈检查
            if self._consecutive_errors >= self._max_consecutive_errors:
                await self._self_heal()
        
        return task
    
    async def _execute_directive(self, task: Task) -> Any:
        """直接执行 - 低自主性"""
        # 解析意图为工具调用
        tool_calls = task.tool_calls
        
        results = []
        for call in tool_calls:
            result = await self._harness.call(
                call,
                ExecutionContext(
                    trace_id=task.task_id,
                    caller_agent=self._profile.agent_id
                )
            )
            results.append(result)
            task.tool_results.append(result)
        
        return results
    
    async def _execute_planned(self, task: Task) -> Any:
        """计划执行 - 中等自主性"""
        # 使用 LLM 生成计划
        plan = await self._generate_plan(task)
        
        # 执行计划
        for step in plan:
            result = await self._harness.call(step, ExecutionContext())
            if result.status != "success":
                # 重规划
                plan = await self._replan(task, step, result)
        
        return plan
    
    async def _execute_autonomous(self, task: Task) -> Any:
        """自主执行 - 高自主性"""
        # 自主决策循环
        # 观察 →  orient → 决定 → 行动
        max_iterations = 10
        for i in range(max_iterations):
            # 观察
            observation = await self._observe()
            
            # 判断
            decision = await self._decide(observation, task)
            
            # 行动
            if decision["action"] == "complete":
                return decision["result"]
            
            # 执行工具调用
            result = await self._harness.call(decision["tool_call"])
            
            # 学习
            await self._learn(observation, decision, result)
        
        return {"status": "max_iterations_reached"}
    
    async def _generate_plan(self, task: Task) -> List[Any]:
        """生成执行计划"""
        # 使用 LLM 或规则引擎生成
        return task.tool_calls
    
    async def _replan(self, task: Task, failed_step: Any, error: Any) -> List[Any]:
        """重规划"""
        # 调整计划
        return []
    
    async def _observe(self) -> Dict:
        """观察环境"""
        return {
            "vitals": self.get_vitals(),
            "queue_depth": self._task_queue.qsize(),
            "available_tools": list(self._tools.keys())
        }
    
    async def _decide(self, observation: Dict, task: Task) -> Dict:
        """自主决策"""
        # LLM 决策
        return {"action": "complete", "result": {}}
    
    async def _learn(self, observation: Dict, decision: Dict, result: ToolResult):
        """学习"""
        self._short_term_memory.append({
            "observation": observation,
            "decision": decision,
            "result": result,
            "timestamp": asyncio.get_event_loop().time()
        })
        
        # 限制记忆大小
        if len(self._short_term_memory) > self._max_memory_size:
            self._short_term_memory = self._short_term_memory[-self._max_memory_size:]
    
    async def get_vitals(self) -> VitalSigns:
        """获取生命体征"""
        import psutil
        process = psutil.Process()
        
        return VitalSigns(
            cpu_usage=process.cpu_percent() / 100.0,
            memory_usage=process.memory_percent() / 100.0,
            task_queue_depth=self._task_queue.qsize(),
            error_rate_1m=0.0,  # 实际计算
            last_heartbeat=datetime.utcnow()
        )
    
    async def enter_dormancy(self) -> None:
        """进入休眠 - 释放资源但保持状态"""
        self._state = LifeState.DORMANT
        # 暂停非必要任务
        for task in self._running_tasks.values():
            if not task.done():
                # 标记为可取消
                pass
        logger.info(f"Agent {self._profile.name} entered dormancy")
    
    async def wake(self) -> None:
        """唤醒"""
        self._state = LifeState.ALIVE
        logger.info(f"Agent {self._profile.name} woke up")
    
    async def terminate(self) -> None:
        """终止"""
        self._state = LifeState.DEAD
        self._shutdown_event.set()
        
        if self._heartbeat_task:
            self._heartbeat_task.cancel()
        if self._main_loop_task:
            self._main_loop_task.cancel()
        
        logger.info(f"Agent {self._profile.name} terminated")
    
    async def _heartbeat_loop(self):
        """心跳循环"""
        while not self._shutdown_event.is_set():
            try:
                vitals = await self.get_vitals()
                self._profile.vital_signs = vitals
                
                # 健康检查
                if vitals.health_score < 0.3:
                    self._state = LifeState.INJURED
                    await self._self_heal()
                elif vitals.health_score < 0.6:
                    self._state = LifeState.STRESSED
                
                # 发射心跳事件
                await self._harness.emit_event(LifeEvent(
                    event_type="heartbeat",
                    source_id=self._profile.agent_id,
                    payload=asdict(vitals)
                ))
                
                await asyncio.wait_for(
                    self._shutdown_event.wait(),
                    timeout=self._heartbeat_interval
                )
            except asyncio.TimeoutError:
                continue
            except Exception as e:
                logger.error(f"Heartbeat error: {e}")
    
    async def _main_loop(self):
        """主工作循环"""
        while not self._shutdown_event.is_set():
            try:
                # 获取任务（带超时）
                task = await asyncio.wait_for(
                    self._task_queue.get(),
                    timeout=1.0
                )
                
                # 检查并发限制
                active = sum(1 for t in self._running_tasks.values() if not t.done())
                if active >= self._profile.max_concurrent_tasks:
                    # 重新入队
                    await self._task_queue.put(task)
                    await asyncio.sleep(0.1)
                    continue
                
                # 执行任务
                task_future = asyncio.create_task(self.execute_task(task))
                self._running_tasks[str(task.task_id)] = task_future
                
                # 清理已完成任务
                done = [k for k, t in self._running_tasks.items() if t.done()]
                for k in done:
                    del self._running_tasks[k]
                    
            except asyncio.TimeoutError:
                continue
            except Exception as e:
                logger.error(f"Main loop error: {e}")
    
    async def _self_heal(self):
        """自愈机制"""
        self._state = LifeState.HEALING
        logger.warning(f"Agent {self._profile.name} initiating self-heal")
        
        # 1. 释放资源
        await self.enter_dormancy()
        
        # 2. 重置错误计数
        self._consecutive_errors = 0
        
        # 3. 清理记忆
        self._short_term_memory = self._short_term_memory[-100:]  # 保留最近100条
        
        # 4. 重新初始化
        await asyncio.sleep(2)
        await self.wake()
        
        self._state = LifeState.ALIVE
        logger.info(f"Agent {self._profile.name} self-heal complete")
    
    def _on_harness_event(self, event: LifeEvent):
        """处理 harness 事件"""
        # 可覆盖以响应系统级事件
        pass
    
    def enqueue_task(self, task: Task) -> None:
        """入队任务"""
        self._task_queue.put_nowait(task)


class AgentNursery:
    """
    Agent 孵化器 - 管理 Agent 生命周期
    生命体隐喻：子宫/孵化器
    """
    
    def __init__(self, harness: HermesHarness):
        self._harness = harness
        self._agents: Dict[str, AgentCell] = {}
        self._lock = asyncio.Lock()
    
    async def create_agent(
        self,
        name: str,
        role: AgentRole,
        capabilities: Set[str],
        config: Optional[Dict] = None
    ) -> AgentCell:
        """创建 Agent"""
        profile = AgentProfile(
            name=name,
            role=role,
            capabilities=capabilities
        )
        
        agent = AgentCell(profile, self._harness)
        
        async with self._lock:
            self._agents[str(profile.agent_id)] = agent
        
        # 孵化
        await agent.spawn(config or {})
        
        return agent
    
    async def get_agent(self, agent_id: str) -> Optional[AgentCell]:
        """获取 Agent"""
        return self._agents.get(agent_id)
    
    async def list_agents(self) -> List[AgentProfile]:
        """列出所有 Agent"""
        return [a.profile for a in self._agents.values()]
    
    async def kill_agent(self, agent_id: str) -> bool:
        """终止 Agent"""
        agent = self._agents.pop(agent_id, None)
        if agent:
            await agent.terminate()
            return True
        return False
    
    async def get_federation_status(self) -> Dict[str, Any]:
        """获取联邦状态"""
        return {
            "total_agents": len(self._agents),
            "alive": sum(1 for a in self._agents.values() if a.profile.state == LifeState.ALIVE),
            "dormant": sum(1 for a in self._agents.values() if a.profile.state == LifeState.DORMANT),
            "injured": sum(1 for a in self._agents.values() if a.profile.state == LifeState.INJURED)
        }
