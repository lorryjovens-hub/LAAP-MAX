"""
Agent Federation - Agent注册、发现与协作系统
近期：中心化注册与静态发现
中期：分布式共识与动态能力证明
远期：自主联邦与信任演化
"""

import asyncio
import hashlib
import json
import logging
import time
from dataclasses import asdict
from datetime import datetime, timedelta
from typing import Dict, List, Optional, Set, Callable, Any
from collections import defaultdict

import grpc
from grpc import aio as grpc_aio

from src.core.types import (
    AgentIdentity, AgentCapability, CollaborationMode,
    EntityId, Intent, CollaborationProposal, CollaborationAgreement,
    DelegationReceipt, MemoryFragment
)

logger = logging.getLogger("cognitive_mesh.federation")


class AgentRegistry:
    """
    Agent注册中心 - 生产级实现
    
    特性：
    - 心跳健康检查
    - 能力索引与匹配
    - 信任评分系统
    - 动态负载均衡
    """
    
    def __init__(
        self,
        heartbeat_interval_sec: int = 30,
        trust_decay_rate: float = 0.01,
        max_agents: int = 10000
    ):
        self._agents: Dict[str, AgentIdentity] = {}
        self._heartbeat: Dict[str, float] = {}  # agent_id -> last_heartbeat
        self._capabilities_index: Dict[AgentCapability, Set[str]] = defaultdict(set)
        self._trust_scores: Dict[str, float] = {}
        self._load_metrics: Dict[str, Dict[str, float]] = defaultdict(lambda: {
            "cpu_usage": 0.0,
            "memory_usage": 0.0,
            "active_tasks": 0,
            "success_rate": 1.0
        })
        self._collaboration_history: Dict[str, List[Dict]] = defaultdict(list)
        
        self.heartbeat_interval = heartbeat_interval_sec
        self.trust_decay_rate = trust_decay_rate
        self.max_agents = max_agents
        
        self._shutdown_event = asyncio.Event()
        self._maintenance_task: Optional[asyncio.Task] = None
    
    async def initialize(self):
        """初始化"""
        self._maintenance_task = asyncio.create_task(self._maintenance_loop())
        logger.info("AgentRegistry initialized")
    
    async def register(self, agent: AgentIdentity) -> bool:
        """
        注册Agent
        
        验证：
        1. 能力声明真实性（中期：能力证明）
        2. 身份签名验证
        3. 容量检查
        """
        agent_key = str(agent.agent_id)
        
        if len(self._agents) >= self.max_agents:
            logger.warning("Registry full, rejecting registration")
            return False
        
        # 验证能力声明（近期：信任声明；中期：要求证明）
        if agent.collaboration_mode.value >= CollaborationMode.CO_CREATION.value:
            # 中期：要求能力证明
            if not self._verify_capability_proofs(agent):
                logger.warning(f"Capability proof verification failed for {agent_key}")
                return False
        
        self._agents[agent_key] = agent
        self._heartbeat[agent_key] = time.time()
        self._trust_scores[agent_key] = agent.trust_score or 0.5
        
        # 更新能力索引
        for cap in agent.capabilities:
            self._capabilities_index[cap].add(agent_key)
        
        logger.info(f"Agent registered: {agent.name} ({agent_key})")
        return True
    
    def _verify_capability_proofs(self, agent: AgentIdentity) -> bool:
        """
        中期功能：验证能力证明
        
        实现方式：
        - 挑战-响应协议
        - 历史执行记录验证
        - 第三方背书
        """
        # 简化实现：检查是否有能力证明
        for cap in agent.capabilities:
            proof_key = f"{cap.value}_proof"
            if proof_key not in agent.capability_proofs:
                return False
        return True
    
    async def heartbeat(self, agent_id: EntityId, metrics: Dict[str, float]):
        """Agent心跳"""
        key = str(agent_id)
        if key not in self._agents:
            raise ValueError(f"Agent {key} not registered")
        
        self._heartbeat[key] = time.time()
        self._load_metrics[key].update(metrics)
        self._load_metrics[key]["last_update"] = time.time()
    
    async def discover(
        self,
        required_capabilities: Set[AgentCapability],
        min_trust_score: float = 0.3,
        max_results: int = 5,
        strategy: str = "capability_match"  # capability_match | trust_weighted | load_balanced
    ) -> List[AgentIdentity]:
        """
        Agent发现 - 支持多种策略
        
        近期：基于能力匹配
        中期：信任加权与负载均衡
        远期：认知兼容性匹配
        """
        # 候选集：具备所有必需能力的Agent
        candidates = set.intersection(*[
            self._capabilities_index[cap] 
            for cap in required_capabilities
        ]) if required_capabilities else set(self._agents.keys())
        
        # 过滤：信任分、健康状态
        healthy_candidates = []
        for key in candidates:
            if key not in self._agents:
                continue
            
            # 健康检查
            last_beat = self._heartbeat.get(key, 0)
            if time.time() - last_beat > self.heartbeat_interval * 3:
                continue  # 超时未心跳
            
            # 信任分检查
            trust = self._trust_scores.get(key, 0)
            if trust < min_trust_score:
                continue
            
            healthy_candidates.append((key, trust))
        
        # 策略排序
        if strategy == "capability_match":
            # 按能力匹配度排序
            scored = [
                (key, len(self._agents[key].capabilities & required_capabilities))
                for key, _ in healthy_candidates
            ]
            scored.sort(key=lambda x: x[1], reverse=True)
        
        elif strategy == "trust_weighted":
            # 信任加权
            scored = healthy_candidates
            scored.sort(key=lambda x: x[1], reverse=True)
        
        elif strategy == "load_balanced":
            # 负载均衡：优先选择负载低的
            scored = [
                (key, 1.0 / (1.0 + self._load_metrics[key].get("active_tasks", 0)))
                for key, _ in healthy_candidates
            ]
            scored.sort(key=lambda x: x[1], reverse=True)
        
        else:
            raise ValueError(f"Unknown strategy: {strategy}")
        
        # 返回结果
        result_keys = [k for k, _ in scored[:max_results]]
        return [self._agents[k] for k in result_keys]
    
