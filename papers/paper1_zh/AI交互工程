        # 1. AST 分析
        ckg = self.ast_analyzer.analyze_module(source, module_name)
        
        # 2. 类型推断增强
        types = self.type_inferencer.infer_types(source)
        for sym_id, sym in ckg.symbols.items():
            if sym.symbol_type in ("function", "method"):
                # 补全缺失的类型注解
                for i, (arg_name, arg_type) in enumerate(sym.inputs):
                    if not arg_type and arg_name in types:
                        sym.inputs[i] = (arg_name, types[arg_name])
        
        # 3. 符号执行路径
        for sym_id, sym in ckg.symbols.items():
            if sym.symbol_type == "function":
                paths = self.symbolic_executor.explore_paths(source, sym.name)
                # 将路径信息存入节点属性
                ckg.graph.nodes[sym_id]["paths"] = paths
        
        self._ckg_cache[cache_key] = ckg
        return ckg
    
    def compress_for_model(
        self,
        ckg: CodeKnowledgeGraph,
        query: Optional[str] = None,
        max_tokens: int = 2000
    ) -> str:
        """
        将知识图谱压缩为模型输入
        
        策略：
        1. 如果 query 存在，只保留相关符号（图注意力）
        2. 按重要性排序（入口点 > 被调用多 > 复杂度高）
        3. 截断到 token 限制
        """
        symbols = list(ckg.symbols.keys())
        
        if query:
            # 基于 query 的相关性排序
            relevance = self._calculate_relevance(ckg, query)
            symbols.sort(key=lambda s: relevance.get(s, 0), reverse=True)
        else:
            # 按重要性：入口点优先，被调用次数多优先
            symbols.sort(key=lambda s: (
                1 if s in ckg.entry_points else 0,
                len(ckg.symbols[s].called_by) if s in ckg.symbols else 0,
                ckg.symbols[s].complexity if s in ckg.symbols else 0
            ), reverse=True)
        
        # 逐步构建 prompt，直到接近 token 限制
        # 估算：每行约 4 tokens
        max_lines = max_tokens // 4
        selected = []
        current_lines = 0
        
        for sym_id in symbols:
            sym = ckg.symbols[sym_id]
            sym_lines = 7 + len(sym.calls) + len(sym.side_effects)  # 估算
            
            if current_lines + sym_lines > max_lines:
                break
            
            selected.append(sym_id)
            current_lines += sym_lines
        
        return ckg.to_structured_prompt(selected)
    
    def _calculate_relevance(self, ckg: CodeKnowledgeGraph, query: str) -> Dict[str, float]:
        """计算符号与 query 的相关性"""
        query_lower = query.lower()
        scores = {}
        
        for sym_id, sym in ckg.symbols.items():
            score = 0.0
            
            # 名称匹配
            if sym.name.lower() in query_lower:
                score += 10.0
            
            # 文档匹配
            if sym.docstring and query_lower in sym.docstring.lower():
                score += 5.0
            
            # 签名匹配
            if query_lower in sym.signature.lower():
                score += 3.0
            
            # 调用关系传播（PageRank 简化）
            for caller in sym.called_by:
                if caller in scores:
                    score += scores[caller] * 0.3
            
            scores[sym_id] = score
        
        return scores
