```python
# src/hermes/cal/code_cognition.py
"""
Code Cognition Engine — 代码认知引擎
将原始代码转化为结构化知识表示，让弱模型获得旗舰级代码理解力。
"""

import ast
import hashlib
import inspect
import logging
import re
import textwrap
from dataclasses import dataclass, field
from pathlib import Path
from typing import Any, Dict, List, Optional, Set, Tuple, Union

import networkx as nx
from tree_sitter import Language, Parser, Tree

logger = logging.getLogger("hermes.cal.code_cognition")


# ─────────────────────────────────────────────────────────────────────────────
# 结构化代码表示（Structured Code Representation）
# 弱模型不需要读 1000 行文本，只需要读 50 行结构化摘要
# ─────────────────────────────────────────────────────────────────────────────

@dataclass
class SymbolNode:
    """符号节点 — 函数/类/变量的结构化表示"""
    symbol_id: str
    name: str
    symbol_type: str  # "function", "class", "method", "variable", "constant"
    signature: str    # 类型签名
    docstring: str
    complexity: int
    lines: Tuple[int, int]
    
    # 语义特征
    inputs: List[Tuple[str, str]] = field(default_factory=list)   # (name, type)
    outputs: List[str] = field(default_factory=list)              # return types
    side_effects: List[str] = field(default_factory=list)         # IO, mutation, etc.
    pure: bool = False
    
    # 关系
    calls: Set[str] = field(default_factory=set)
    called_by: Set[str] = field(default_factory=set)
    reads: Set[str] = field(default_factory=set)
    writes: Set[str] = field(default_factory=set)
    
    # 代码指纹
    ast_hash: str = ""
    behavior_hash: str = ""  # 基于输入输出契约的哈希

@dataclass
class ControlFlowEdge:
    """控制流边"""
    source: str
    target: str
    edge_type: str  # "sequential", "conditional", "loop", "exception"
    condition: Optional[str] = None

@dataclass
class DataFlowEdge:
    """数据流边"""
    source: str
    target: str
    variable: str
    flow_type: str  # "definition", "use", "mutation"

@dataclass
class CodeKnowledgeGraph:
    """代码知识图谱 — 整个代码库的语义网络"""
    graph: nx.MultiDiGraph = field(default_factory=nx.MultiDiGraph)
    symbols: Dict[str, SymbolNode] = field(default_factory=dict)
    entry_points: List[str] = field(default_factory=list)
    hot_paths: List[List[str]] = field(default_factory=list)  # 高频调用链
    
    def to_structured_prompt(self, focus_symbols: Optional[List[str]] = None) -> str:
        """
        将代码知识图谱转化为结构化 Prompt（给弱模型看）
        比原始代码压缩 10-20 倍，但保留完整语义
        """
        lines = ["=== CODE KNOWLEDGE GRAPH ===", ""]
        
        # 只包含相关符号（上下文感知）
        symbols_to_show = focus_symbols or list(self.symbols.keys())
        
        for sym_id in symbols_to_show:
            if sym_id not in self.symbols:
                continue
            sym = self.symbols[sym_id]
            
            # 结构化摘要（一行 = 一个语义单元）
            lines.append(f"SYMBOL: {sym.name} :: {sym.symbol_type}")
            lines.append(f"  SIG: {sym.signature}")
            lines.append(f"  DOC: {sym.docstring[:200] if sym.docstring else 'N/A'}")
            lines.append(f"  COMPLEXITY: {sym.complexity}")
            lines.append(f"  PURE: {sym.pure}")
            lines.append(f"  IO: in={sym.inputs} out={sym.outputs}")
            lines.append(f"  FX: {sym.side_effects}")
            
            # 关系（只展示直接邻居，避免爆炸）
            neighbors = set(sym.calls) | set(sym.reads) | set(sym.writes)
            if neighbors:
                lines.append(f"  REL: -> {sorted(neighbors)[:10]}")
            
            lines.append("")
        
        # 控制流摘要
        lines.append("=== CONTROL FLOW ===")
        for entry in self.entry_points[:5]:
            lines.append(f"ENTRY: {entry}")
        
        return "\n".join(lines)


class ASTAnalyzer:
    """
    AST 分析器 — 深度程序分析
    将 Python AST 转化为丰富的语义信息
    """
    
    def __init__(self):
        self._type_hints: Dict[str, str] = {}
    
    def analyze_module(self, source: str, module_name: str = "") -> CodeKnowledgeGraph:
        """分析整个模块"""
        tree = ast.parse(source)
        ckg = CodeKnowledgeGraph()
        
        # 第一遍：收集所有符号
        for node in ast.walk(tree):
            if isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef)):
                sym = self._analyze_function(node, source, module_name)
                ckg.symbols[sym.symbol_id] = sym
                ckg.graph.add_node(sym.symbol_id, data=sym)
            elif isinstance(node, ast.ClassDef):
                sym = self._analyze_class(node, source, module_name)
                ckg.symbols[sym.symbol_id] = sym
                ckg.graph.add_node(sym.symbol_id, data=sym)
        
        # 第二遍：建立关系
        self._build_relationships(tree, ckg, module_name)
        
        # 第三遍：控制流分析
        self._analyze_control_flow(tree, ckg)
        
        # 第四遍：数据流分析
        self._analyze_data_flow(tree, ckg)
        
        return ckg
    
    def _analyze_function(
        self,
        node: Union[ast.FunctionDef, ast.AsyncFunctionDef],
        source: str,
        module_name: str
    ) -> SymbolNode:
        """分析函数"""
        lines = source.split("\n")
        start = node.lineno
        end = node.end_lineno or start
        
        # 提取签名
        args = []
        for arg in node.args.args:
            arg_type = ""
            if arg.annotation:
                arg_type = ast.unparse(arg.annotation)
            args.append((arg.arg, arg_type))
        
        returns = ""
        if node.returns:
            returns = ast.unparse(node.returns)
        
        signature = f"({', '.join(f'{n}:{t}' for n, t in args)}) -> {returns}"
        
        # 提取 docstring
        docstring = ast.get_docstring(node) or ""
        
        # 计算复杂度
        complexity = self._cyclomatic_complexity(node)
        
        # 分析副作用
        side_effects = self._detect_side_effects(node)
        pure = len(side_effects) == 0
        
        # AST 哈希
        ast_hash = hashlib.sha256(ast.dump(node).encode()).hexdigest()[:16]
        
        sym_id = f"{module_name}:{node.name}"
        
        return SymbolNode(
            symbol_id=sym_id,
            name=node.name,
            symbol_type="async_function" if isinstance(node, ast.AsyncFunctionDef) else "function",
            signature=signature,
            docstring=docstring,
            complexity=complexity,
            lines=(start, end),
            inputs=args,
            outputs=[returns] if returns else [],
            side_effects=side_effects,
            pure=pure,
            ast_hash=ast_hash
        )
    
    def _analyze_class(self, node: ast.ClassDef, source: str, module_name: str) -> SymbolNode:
        """分析类"""
        methods = []
        for item in node.body:
            if isinstance(item, (ast.FunctionDef, ast.AsyncFunctionDef)):
                methods.append(item.name)
        
        sym_id = f"{module_name}:{node.name}"
        
        return SymbolNode(
            symbol_id=sym_id,
            name=node.name,
            symbol_type="class",
            signature=f"class {node.name}({', '.join([ast.unparse(b) for b in node.bases])})",
            docstring=ast.get_docstring(node) or "",
            complexity=sum(self._cyclomatic_complexity(m) for m in node.body if isinstance(m, ast.FunctionDef)),
            lines=(node.lineno, node.end_lineno or node.lineno),
            ast_hash=hashlib.sha256(ast.dump(node).encode()).hexdigest()[:16]
        )
    
    def _cyclomatic_complexity(self, node: ast.AST) -> int:
        """计算圈复杂度"""
        complexity = 1
        for child in ast.walk(node):
            if isinstance(child, (ast.If, ast.While, ast.For, ast.ExceptHandler)):
                complexity += 1
            elif isinstance(child, ast.BoolOp):
                complexity += len(child.values) - 1
            elif isinstance(child, ast.comprehension):
                complexity += 1
        return complexity
    
    def _detect_side_effects(self, node: ast.AST) -> List[str]:
        """检测副作用"""
        effects = []
        
        for child in ast.walk(node):
            # 文件 IO
            if isinstance(child, ast.Call):
                func_name = self._get_call_name(child)
                if func_name and any(io in func_name for io in ["open", "read", "write", "print"]):
                    effects.append(f"io:{func_name}")
            
            # 全局变量修改
            if isinstance(child, ast.Global):
                effects.append(f"global:{child.names}")
            
            # 类属性/外部状态修改
            if isinstance(child, ast.Assign):
                for target in child.targets:
                    if isinstance(target, ast.Attribute):
                        effects.append(f"mutate:{ast.unparse(target)}")
        
        return effects
    
    def _get_call_name(self, node: ast.Call) -> str:
        """获取调用名称"""
        if isinstance(node.func, ast.Name):
            return node.func.id
        elif isinstance(node.func, ast.Attribute):
            parts = []
            n = node.func
            while isinstance(n, ast.Attribute):
                parts.append(n.attr)
                n = n.value
            if isinstance(n, ast.Name):
                parts.append(n.id)
            return ".".join(reversed(parts))
        return ""
    
    def _build_relationships(self, tree: ast.AST, ckg: CodeKnowledgeGraph, module_name: str):
        """构建符号间关系"""
        for node in ast.walk(tree):
            if isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef)):
                sym_id = f"{module_name}:{node.name}"
                
                for child in ast.walk(node):
                    if isinstance(child, ast.Call):
                        callee = self._get_call_name(child)
                        if callee:
                            callee_id = f"{module_name}:{callee}" if "." not in callee else callee
                            if sym_id in ckg.symbols:
                                ckg.symbols[sym_id].calls.add(callee_id)
                                if callee_id in ckg.symbols:
                                    ckg.symbols[callee_id].called_by.add(sym_id)
                                ckg.graph.add_edge(sym_id, callee_id, type="call")
    
    def _analyze_control_flow(self, tree: ast.AST, ckg: CodeKnowledgeGraph):
        """控制流分析"""
        # 识别入口点
        for sym_id, sym in ckg.symbols.items():
            if sym.symbol_type == "function" and not sym.called_by:
                ckg.entry_points.append(sym_id)
    
    def _analyze_data_flow(self, tree: ast.AST, ckg: CodeKnowledgeGraph):
        """数据流分析（简化版）"""
        pass


class TypeInferencer:
    """
    类型推断器 — 增强弱模型的类型理解
    即使模型不擅长类型，我们也能通过静态分析补全
    """
    
    def infer_types(self, source: str) -> Dict[str, str]:
        """
        推断代码中的类型信息
        返回 {symbol: type_annotation}
        """
        tree = ast.parse(source)
        types = {}
        
        for node in ast.walk(tree):
            if isinstance(node, ast.AnnAssign):
                # 已有注解
                if isinstance(node.annotation, ast.Name):
                    types[ast.unparse(node.target)] = node.annotation.id
            elif isinstance(node, ast.Assign):
                # 基于右侧推断
                for target in node.targets:
                    if isinstance(target, ast.Name):
                        inferred = self._infer_from_value(node.value)
                        if inferred:
                            types[target.id] = inferred
        
        return types
    
    def _infer_from_value(self, node: Optional[ast.expr]) -> Optional[str]:
        """从赋值右侧推断类型"""
        if node is None:
            return None
        
        if isinstance(node, ast.Constant):
            if isinstance(node.value, str):
                return "str"
            elif isinstance(node.value, int):
                return "int"
            elif isinstance(node.value, float):
                return "float"
            elif isinstance(node.value, bool):
                return "bool"
        elif isinstance(node, ast.List):
            return "list"
        elif isinstance(node, ast.Dict):
            return "dict"
        elif isinstance(node, ast.Set):
            return "set"
        elif isinstance(node, ast.Call):
            # 基于函数名推断
            return None  # 需要跨函数分析
        
        return None


class SymbolicExecutor:
    """
    符号执行器 — 轻量级路径探索
    让弱模型"看到"代码的执行路径，而非仅靠文本猜测
    """
    
    def __init__(self, max_paths: int = 10):
        self.max_paths = max_paths
    
    def explore_paths(self, func_source: str, func_name: str) -> List[Dict]:
        """
        探索函数的执行路径
        返回每条路径的条件和可达性
        """
        tree = ast.parse(func_source)
        
        for node in ast.walk(tree):
            if isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef)) and node.name == func_name:
                return self._explore_function_paths(node)
        
        return []
    
    def _explore_function_paths(self, node: ast.FunctionDef) -> List[Dict]:
        """探索函数路径"""
        paths = []
        
        # 简化的路径探索：收集所有条件分支
        conditions = []
        for child in ast.walk(node):
            if isinstance(child, ast.If):
                conditions.append(ast.unparse(child.test))
        
        # 生成路径组合（简化：不真正做符号求解，而是结构化呈现）
        if not conditions:
            paths.append({"path_id": 0, "conditions": [], "reachable": True})
        else:
            for i, cond in enumerate(conditions):
                paths.append({
                    "path_id": i,
                    "conditions": [cond, f"NOT ({cond})"],
                    "reachable": "unknown"  # 需要 SMT 求解器确定
                })
        
        return paths


class CodeCognitionEngine:
    """
    代码认知引擎 — 对外接口
    将任何代码输入转化为弱模型可高效理解的结构化表示
    """
    
    def __init__(self):
        self.ast_analyzer = ASTAnalyzer()
        self.type_inferencer = TypeInferencer()
        self.symbolic_executor = SymbolicExecutor()
        
        # 缓存
