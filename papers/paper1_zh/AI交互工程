@dataclass
class Artifact:
    """产物"""
    artifact_id: LifeID = field(default_factory=lambda: LifeID(EntityKind.ARTIFACT))
    mime_type: str = "text/plain"
    content: Union[str, bytes] = b""
    encoding: str = "utf-8"
    size_bytes: int = 0
    checksum: str = ""
    
    def verify(self) -> bool:
        if isinstance(self.content, str):
            data = self.content.encode(self.encoding)
        else:
            data = self.content
        return hashlib.sha256(data).hexdigest()[:16] == self.checksum

