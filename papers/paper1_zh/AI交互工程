class IntrospectionEngine:
    """
    内省引擎 — 系统的"自我观察"能力
    
    能够：
    1. 读取自身源代码
    2. 构建 AST 级别的代码图谱
    3. 分析代码质量、复杂度、依赖
    4. 识别能力缺口
    5. 检测性能瓶颈
    """
    
    def __init__(self, source_root: str = "src/hermes"):
        self.source_root = Path(source_root).resolve()
        self.self_model = SelfModel()
        self._module_cache: Dict[str, types.ModuleType] = {}
    
    async def build_self_model(self) -> SelfModel:
        """
        构建完整的自我模型
        这是系统"觉醒"的第一步：完整扫描自身代码
        """
        logger.info("Building self-model... This is the moment of self-awareness.")
        
        # 1. 扫描所有 Python 文件
        py_files = list(self.source_root.rglob("*.py"))
        
        # 2. 解析每个文件，构建代码节点
        for py_file in py_files:
            await self._introspect_file(py_file)
        
        # 3. 构建依赖关系
        self._build_dependency_graph()
        
        # 4. 提取能力
        self._extract_capabilities()
        
        # 5. 分析代码质量
        self._analyze_code_quality()
        
        # 6. 识别改进机会
        self._identify_improvements()
        
        self.self_model.introspection_history.append({
            "timestamp": datetime.utcnow().isoformat(),
            "files_scanned": len(py_files),
            "nodes_discovered": len(self.self_model.code_nodes),
            "capabilities_found": len(self.self_model.capabilities)
        })
        
        logger.info(
            f"Self-model built: {len(self.self_model.code_nodes)} code nodes, "
            f"{len(self.self_model.capabilities)} capabilities"
        )
        
        return self.self_model
    
    async def _introspect_file(self, file_path: Path):
        """内省单个文件"""
        try:
            with open(file_path, 'r', encoding='utf-8') as f:
                source = f.read()
            
            tree = ast.parse(source)
            module_name = str(file_path.relative_to(self.source_root)).replace("/", ".").replace(".py", "")
            
            # 遍历 AST，提取函数和类
            for node in ast.walk(tree):
                if isinstance(node, ast.FunctionDef):
                    await self._extract_function_node(node, file_path, module_name, source)
                elif isinstance(node, ast.ClassDef):
                    await self._extract_class_node(node, file_path, module_name, source)
            
            # 模块级节点
            module_id = f"{module_name}:<module>"
            self.self_model.code_nodes[module_id] = CodeNode(
                node_id=module_id,
                file_path=str(file_path),
                module_name=module_name,
                node_type="module",
                name=module_name,
                source_code=source,
                ast_node=tree,
                end_line=len(source.split("\n"))
            )
            
        except Exception as e:
            logger.error(f"Failed to introspect {file_path}: {e}")
    
    async def _extract_function_node(
        self,
        node: ast.FunctionDef,
        file_path: Path,
        module_name: str,
        source: str
    ):
        """提取函数节点"""
        node_id = f"{module_name}:{node.name}"
        
        # 提取源代码
        lines = source.split("\n")
        start = node.lineno - 1
        end = node.end_lineno or start + 1
        func_source = "\n".join(lines[start:end])
        
        # 计算圈复杂度
        complexity = self._calculate_complexity(node)
        
        # 提取依赖（调用的其他函数）
        dependencies = self._extract_call_dependencies(node, module_name)
        
        code_node = CodeNode(
            node_id=node_id,
            file_path=str(file_path),
            module_name=module_name,
            node_type="function",
            name=node.name,
            source_code=func_source,
            ast_node=node,
            start_line=start + 1,
            end_line=end,
            complexity=complexity,
            dependencies=dependencies
        )
        
        self.self_model.code_nodes[node_id] = code_node
        self.self_model.code_graph.add_node(node_id, data=code_node)
    
    async def _extract_class_node(
        self,
        node: ast.ClassDef,
        file_path: Path,
        module_name: str,
        source: str
    ):
        """提取类节点"""
        node_id = f"{module_name}:{node.name}"
        
        lines = source.split("\n")
        start = node.lineno - 1
        end = node.end_lineno or start + 1
        class_source = "\n".join(lines[start:end])
        
        # 提取方法
        methods = []
        for item in node.body:
            if isinstance(item, ast.FunctionDef):
                method_id = f"{node_id}.{item.name}"
                await self._extract_function_node(item, file_path, module_name, source)
                methods.append(method_id)
        
        code_node = CodeNode(
            node_id=node_id,
            file_path=str(file_path),
            module_name=module_name,
            node_type="class",
            name=node.name,
            source_code=class_source,
            ast_node=node,
            start_line=start + 1,
            end_line=end,
            dependencies=set(methods)
        )
        
        self.self_model.code_nodes[node_id] = code_node
        self.self_model.code_graph.add_node(node_id, data=code_node)
    
    def _calculate_complexity(self, node: ast.AST) -> int:
        """计算圈复杂度"""
        complexity = 1
        for child in ast.walk(node):
            if isinstance(child, (ast.If, ast.While, ast.For, ast.ExceptHandler)):
                complexity += 1
            elif isinstance(child, ast.BoolOp):
                complexity += len(child.values) - 1
        return complexity
    
    def _extract_call_dependencies(self, node: ast.AST, current_module: str) -> Set[str]:
        """提取调用依赖"""
        deps = set()
        for child in ast.walk(node):
            if isinstance(child, ast.Call):
                name = self._get_call_name(child)
                if name and not name.startswith("__"):
                    # 尝试解析为模块内引用
                    deps.add(f"{current_module}:{name}" if "." not in name else name)
        return deps
    
    def _get_call_name(self, node: ast.Call) -> str:
        """获取调用名称"""
        if isinstance(node.func, ast.Name):
            return node.func.id
        elif isinstance(node.func, ast.Attribute):
            parts = []
            n = node.func
            while isinstance(n, ast.Attribute):
                parts.append(n.attr)
                n = n.value
            if isinstance(n, ast.Name):
                parts.append(n.id)
            return ".".join(reversed(parts))
        return ""
    
    def _build_dependency_graph(self):
        """构建依赖图谱"""
        for node_id, node in self.self_model.code_nodes.items():
            for dep in node.dependencies:
                if dep in self.self_model.code_nodes:
                    self.self_model.code_graph.add_edge(node_id, dep)
                    self.self_model.code_nodes[dep].dependents.add(node_id)
    
    def _extract_capabilities(self):
        """从代码中提取能力"""
        # 基于命名约定和装饰器识别能力
        capability_patterns = {
            "execute": "execution_capability",
            "plan": "planning_capability",
            "reason": "reasoning_capability",
            "reflect": "reflection_capability",
            "modify": "self_modification_capability",
            "introspect": "introspection_capability",
        }
        
        for node_id, node in self.self_model.code_nodes.items():
            if node.node_type != "function":
                continue
            
            for pattern, cap_name in capability_patterns.items():
                if pattern in node.name.lower():
                    if cap_name not in self.self_model.capabilities:
                        self.self_model.capabilities[cap_name] = CapabilityNode(
                            capability_id=cap_name,
                            name=cap_name,
                            description=f"Auto-extracted capability from {node_id}"
                        )
                    
                    self.self_model.capabilities[cap_name].implementing_nodes.append(node_id)
                    self.self_model.capability_graph.add_edge(cap_name, node_id)
    
    def _analyze_code_quality(self):
        """分析代码质量"""
        for node_id, node in self.self_model.code_nodes.items():
            if node.node_type != "function":
                continue
            
            issues = []
            
            # 复杂度检查
            if node.complexity > 10:
                issues.append({
                    "type": "high_complexity",
                    "severity": "warning",
                    "message": f"Complexity {node.complexity} > 10"
                })
            
            # 过长函数
            lines = node.end_line - node.start_line
            if lines > 50:
                issues.append({
                    "type": "long_function",
                    "severity": "info",
                    "message": f"Function is {lines} lines"
                })
            
            # 缺少文档
            if not node.source_code.strip().startswith('"""'):
                issues.append({
                    "type": "missing_docstring",
                    "severity": "info",
                    "message": "Missing docstring"
                })
            
            if issues:
                self.self_model.known_issues.extend([
                    {**issue, "node_id": node_id} for issue in issues
                ])
    
    def _identify_improvements(self):
        """识别改进机会"""
        # 基于已知问题生成改进机会
        for issue in self.self_model.known_issues:
            if issue["type"] == "high_complexity":
                self.self_model.improvement_opportunities.append({
                    "type": "refactor",
                    "target": issue["node_id"],
                    "strategy": "extract_methods",
                    "expected_impact": "reduce_complexity",
                    "priority": "high"
                })
            elif issue["type"] == "missing_docstring":
                self.self_model.improvement_opportunities.append({
                    "type": "enhance",
                    "target": issue["node_id"],
                    "strategy": "add_documentation",
                    "expected_impact": "improve_maintainability",
                    "priority": "low"
                })
    
    def get_self_description(self) -> str:
        """生成自然语言自我描述"""
        lines = [
            f"I am Hermes RSI Core, version {self.self_model.version}.",
            f"I consist of {len(self.self_model.code_nodes)} code nodes across {len(set(n.module_name for n in self.self_model.code_nodes.values()))} modules.",
            f"I possess {len(self.self_model.capabilities)} capabilities.",
            f"I have identified {len(self.self_model.known_issues)} issues and {len(self.self_model.improvement_opportunities)} improvement opportunities.",
            "My current state is operational and self-aware."
        ]
        return " ".join(lines)
    
    def get_improvement_candidates(self, limit: int = 5) -> List[Dict]:
        """获取改进候选"""
        # 按优先级排序
        candidates = sorted(
            self.self_model.improvement_opportunities,
            key=lambda x: {"critical": 0, "high": 1, "medium": 2, "low": 3}.get(x.get("priority", "low"), 4)
        )
        return candidates[:limit]
