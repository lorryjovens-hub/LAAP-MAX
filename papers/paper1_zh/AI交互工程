    memory_id: EntityId = field(default_factory=lambda: EntityId("memory"))
    memory_type: str = "episodic"  # episodic | semantic | procedural
    content: Union[str, bytes, Dict[str, Any]] = ""
    embedding: Optional[List[float]] = None
