+
+    # ══════════════════════════════════════════════════════
+    # 基准测试: 认知深度
+    # ══════════════════════════════════════════════════════
+
+    def benchmark_cognitive_depth(self) -> BenchmarkResult:
+        """认知深度 — 推理路径质量"""
+        brain = self.brain
+        if not brain:
+            return BenchmarkResult("认知深度", 0, 0, 0, "paths")
+
+        # LAAP: 通过 before_turn 触发完整认知链
+        test_inputs = [
+            "分析系统日志中的性能瓶颈",
+            "修复数据库连接超时的Bug",
